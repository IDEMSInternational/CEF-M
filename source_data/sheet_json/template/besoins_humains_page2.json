{
  "flow_type": "template",
  "flow_name": "besoins_humains_page2",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "PREVISIONS DES PERSONNES A NOURRIR"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "html",
      "value": "Donnez le nombre de personnes à nourrir dans votre UPA à partir des récoltes de la saision hivernale prochaine:<span style=\"color: red;\">*</span>"
    },
    {
      "type": "audio",
      "name": "audio_4_1",
      "parameter_list": "variant: button_only;\nsrc: audio/alimentationHumaine/nombre_nourris_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/membre_upa.jpg",
      "style_list": "width:180px; height:180px;"
    },
    {
      "type": "html",
      "value": "<p style=\"color: #666; font-size: 13px; line-height: 1.5;\">Il s'agit du nombre de personnes (adultes et enfants) dont l'alimentation sera assurée sur 12 mois, à partir des récoltés en octobre de cette année.</p>"
    },
    {
      "type": "text_box",
      "name": "personnes_nourrir",
      "value": "@fields.personnes_nourrir",
      "action_list": "changed | set_field: personnes_nourrir : this.value;",
      "parameter_list": "placeholder: Nombre de personnes;input_type: number;",
      "style_list": "margin-top: 10px;"
    },
    {
      "name": "besoin_cereale_exploitation",
      "value": "@calc(Number(@fields.personnes_nourrir || 0) * 3)"
    },
    {
      "type": "html",
      "value": "<p style=\"color: red;\"> @global.reponse_obligatoire </p>",
      "condition": "!@fields.personnes_nourrir && @fields.attempt_submit"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.personnes_nourrir > 0"
    },
    {
      "type": "text",
      "value": "**PREVISIONS**"
    },
    {
      "type": "audio",
      "name": "audio_4_1",
      "parameter_list": "variant: button_only;\nsrc: audio/alimentationHumaine/total_besoin_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "prevision",
      "condition": "@fields.personnes_nourrir > 0",
      "style_list": "background: #1e3656; padding: 15px; border-radius: 12px; color: white;"
    },
    {
      "type": "image",
      "value": "images/besoin_upa.jpg",
      "style_list": "width:180px; height:180px;"
    },
    {
      "type": "html",
      "value": "<div style=\"overflow: hidden;\">\n    <div style=\"text-transform: uppercase; font-size: 15px; color: #4f8ff1; font-weight: bold; margin-bottom: 2px;\"> @fields.personnes_nourrir personnes à nourrir à partir des récoltes prochaines,l'UPA doit prévoire :</div>\n    <div style=\"font-size: 22px; font-weight: bold; margin-bottom: 4px;\">\n        @local.besoin_cereale_exploitation <span style=\"font-size: 14px; font-weight: normal;\">sacs de céréales</span>\n    </div>\n    <p style=\"font-size: 11px; color: #cbd5e0; line-height: 1.2; margin: 0;\">\n        Ces sacs de céréales couvrent généralement les besoins alimentaires (prévus ou non) des <b>@field.personnes_nourrir membres</b> / 12 mois.\n    </p>\n</div>\n<div style=\"clear: both;\"></div>"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.personnes_nourrir"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page4_button_back",
      "action_list": "click | set_field: attempt_submit: false;\nclick | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_continue_attempt_submit",
      "value": "Continuer",
      "action_list": "click | set_field: attempt_submit: true;\n",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_4button_completed",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: besoin_cereale_exploitation : @local.besoin_cereale_exploitation;\nclick | set_field: attempt_submit: false;\n\nclick | emit: completed",
      "parameter_list": "\ndisabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}