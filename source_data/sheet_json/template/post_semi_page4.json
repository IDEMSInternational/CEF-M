{
  "flow_type": "template",
  "flow_name": "post_semi_page4",
  "status": "released",
  "rows": [
    {
      "name": "v_current_human",
      "value": "@calc(Number(@field.current_culture_index) + 1)"
    },
    {
      "type": "begin_display_group",
      "name": "header_top",
      "style_list": "background: #00adcc; padding: 15px; border-radius: 0 0 15px 15px; margin-bottom: 20px;"
    },
    {
      "type": "html",
      "value": "<div style=\"color: white; font-weight: bold; font-size: 14px;\">CULTURE @local.v_current_human / @field.total_cultures_selected </div>"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "title",
      "value": "DÉTAILS DE LA CULTURE : PROTECTION CHIMIQUE"
    },
    {
      "type": "begin_display_group",
      "style_list": "width: 100%; display: flex; flex-direction: column; align-items: center; border: 1px solid #FFCC80; border-radius: 12px; background: white; margin-bottom: 10px; overflow: hidden;"
    },
    {
      "type": "image",
      "value": "@calc(['mais','mil','sorgho','coton','arachide','fourrage','fonio','riz','sésame','wouandzou','patate','bissap'].includes((@field.active_culture_name || '').toLowerCase().trim()) ? 'images/' + @field.active_culture_name + '.jpg' : 'images/autre.jpeg')",
      "style_list": "width: 100px; height: 100px;"
    },
    {
      "type": "text",
      "value": "<h3 style='color: black; margin: 10px 0;'>Culture : <span style='color: #e3a730;'>@field.active_culture_name</span></h3>",
      "style_list": "font-weight: bold; font-size: 18px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "v_quantite_herbicide_fmt",
      "value": "@calc(/^\\d+(\\.\\d+)?$/.test(@field.quantite_herbicide))"
    },
    {
      "name": "v_quantite_herbicide_pos",
      "value": "@calc(@local.v_quantite_herbicide_fmt && Number(@field.quantite_herbicide) > 0)"
    },
    {
      "name": "v_quantite_herbicide_err",
      "value": "@calc(!@local.v_quantite_herbicide_fmt || Number(@field.quantite_herbicide) < 0)"
    },
    {
      "type": "html",
      "value": "<br><b style=\"color: #e67e22\">1. HERBICIDAGE</b>"
    },
    {
      "type": "begin_display_group",
      "name": "herbicide_group",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "name": "herbicide_note",
      "parameter_list": "variant: button_only;\nsrc: audio/postSemi/q_herbicide_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "html",
      "value": "Quantité Herbicide utilisée (Flacons)<span style=\"color: red;\">*</span>"
    },
    {
      "type": "image",
      "value": "images/flacon.jpg",
      "style_list": "width: 100px; height: 100px;"
    },
    {
      "type": "text_box",
      "name": "quantite_herbicide",
      "value": "@field.quantite_herbicide",
      "action_list": "changed | set_field: quantite_herbicide : this.value;",
      "parameter_list": "number_input: true; placeholder: 0;"
    },
    {
      "type": "text",
      "value": "Mettz une valeur positive.",
      "condition": "@local.v_quantite_herbicide_err",
      "style_list": "color: red; font-size: 12px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "npk_cost_card",
      "condition": "@local.v_quantite_herbicide_pos",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "parameter_list": "variant: button_only;\nsrc: audio/postSemi/cout_herbicide_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "html",
      "value": "Coût total Herbicide (Dram)<span style=\"color: red;\">*</span>"
    },
    {
      "type": "text",
      "value": "*Rappel : 1 dram = 5 FCFA*",
      "style_list": "font-size: 14px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width: 100px; height: 100px;"
    },
    {
      "type": "text_box",
      "name": "cout_herbicide_nonzero",
      "value": "@field.cout_herbicide_nonzero",
      "action_list": "changed | set_field: cout_herbicide_nonzero : this.value;",
      "parameter_list": "number_input: true; placeholder: Coût total herbicide...;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "npk_cost_card_zero",
      "condition": "@field.quantite_herbicide == 0",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "parameter_list": "variant: button_only;\nsrc: audio/postSemi/cout_herbicide_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "html",
      "value": "Coût total Herbicide (Dram)<span style=\"color: red;\">*</span>"
    },
    {
      "type": "text",
      "value": "*Rappel : 1 dram = 5 FCFA*",
      "style_list": "font-size: 14px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width: 100px; height: 100px;"
    },
    {
      "type": "text_box",
      "name": "cout_herbicide_zero",
      "value": 0,
      "parameter_list": "disabled:true;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "v_quantite_insecticide_fmt",
      "value": "@calc(/^\\d+(\\.\\d+)?$/.test(@field.quantite_insecticide))"
    },
    {
      "name": "v_quantite_insecticide_pos",
      "value": "@calc(@local.v_quantite_insecticide_fmt && Number(@field.quantite_insecticide) > 0)"
    },
    {
      "name": "v_quantite_insecticide_err",
      "value": "@calc(!@local.v_quantite_insecticide_fmt || Number(@field.quantite_insecticide) < 0)"
    },
    {
      "type": "html",
      "value": "<br><b style=\"color: #e67e22\">2. INSECTICIDAGE</b>"
    },
    {
      "type": "begin_display_group",
      "name": "insecticide_group",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "name": "insecticide_note",
      "parameter_list": "variant: button_only;\nsrc: audio/postSemi/q_insecticide_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "html",
      "value": "Quantité Insecticide utilisée (Flacons)<span style=\"color: red;\">*</span>"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "quantite_insecticide",
      "value": "@field.quantite_insecticide",
      "action_list": "changed | set_field: quantite_insecticide : this.value;",
      "parameter_list": "number_input: true; placeholder: 0;"
    },
    {
      "type": "image",
      "value": "images/flacon.jpg",
      "style_list": "width: 100px; height: 100px;"
    },
    {
      "type": "text",
      "value": "Mettez une valeur positive.",
      "condition": "@local.v_quantite_insecticide_err",
      "style_list": "color: red; font-size: 12px;"
    },
    {
      "type": "begin_display_group",
      "name": "card_cout",
      "condition": "@local.v_quantite_insecticide_pos",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "parameter_list": "variant: button_only;\nsrc: audio/postSemi/cout_insecticide_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "html",
      "value": "Coût total Insecticide (Dram)<span style=\"color: red;\">*</span>"
    },
    {
      "type": "text",
      "value": "*Rappel : 1 dram = 5 FCFA*",
      "style_list": "font-size: 14px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width: 100px; height: 100px;"
    },
    {
      "type": "text_box",
      "name": "cout_insecticide_nonzero",
      "value": "@field.cout_insecticide_nonzero",
      "action_list": "changed | set_field: cout_insecticide_nonzero : this.value;",
      "parameter_list": "placeholder: Coût total insecticide...; number_input: true;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "card_cout_zero",
      "condition": "@field.quantite_insecticide == 0",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "parameter_list": "variant: button_only;\nsrc: audio/postSemi/cout_insecticide_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "html",
      "value": "Coût total Insecticide (Dram)<span style=\"color: red;\">*</span>"
    },
    {
      "type": "text",
      "value": "*Rappel : 1 dram = 5 FCFA*",
      "style_list": "font-size: 14px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width: 100px; height: 100px;"
    },
    {
      "type": "text_box",
      "name": "cout_insecticide_zero",
      "value": 0,
      "parameter_list": "disabled:true;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "v_phyto_herb_ok",
      "value": "@calc(@local.v_quantite_herbicide_fmt && (Number(@field.quantite_herbicide) === 0 || (Number(@field.cout_herbicide_nonzero) >= 0 && @field.cout_herbicide_nonzero !== '')))"
    },
    {
      "name": "v_phyto_ins_ok",
      "value": "@calc(@local.v_quantite_insecticide_fmt && (Number(@field.quantite_insecticide) === 0 || (Number(@field.cout_insecticide_nonzero) >= 0 && @field.cout_insecticide_nonzero !== '')))"
    },
    {
      "name": "v_total_phyto_culture",
      "value": "@calc((Number(@field.cout_herbicide_nonzero) || 0) + (Number(@field.cout_insecticide_nonzero) || 0))"
    },
    {
      "name": "completed_enabled",
      "value": "@calc(@local.v_phyto_herb_ok && @local.v_phyto_ins_ok)"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_completed",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: final_count_phyto: @local.v_total_phyto_culture;\nclick | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}