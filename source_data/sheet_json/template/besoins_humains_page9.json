{
  "flow_type": "template",
  "flow_name": "besoins_humains_page9",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "OBSERVATIONS"
    },
    {
      "type": "audio",
      "name": "audio_obs",
      "parameter_list": "variant: compact;\nsrc: audio/bHumains/canal_obser_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "html",
      "value": "<h3 style=\"color: #1e3656; margin: 0 0 10px 0; font-size: 16px;\">COMMENTER LA PLANIFICATION</h3>"
    },
    {
      "type": "image",
      "value": "images/obs_nourriture.jpg",
      "style_list": "gwidth: 100%; border-radius: 10px; margin-bottom: 15px;"
    },
    {
      "type": "radio_button_grid",
      "name": "type_observation",
      "value": "@field.type_observation",
      "action_list": "changed | set_field: type_observation : this.value;",
      "parameter_list": "answer_list: @data.group_observation;\nvariant: flex;\nitem_width: 60px;\ngrid_gap: 8px;"
    },
    {
      "type": "begin_display_group",
      "name": "obs_audio",
      "condition": "@field.type_observation == 'par_vocal'",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "parameter_list": "variant: compact;\nsrc: audio/bHumains/Obser_audio_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;margin:10px"
    },
    {
      "type": "text",
      "value": "Enregistrer votre observation vocale",
      "style_list": "icon: mic; color: #1e3656;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "obs_photo",
      "condition": "@field.type_observation == 'par_photo'",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "parameter_list": "variant: compact;\nsrc: audio/bHumains/Obser_photo_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;margin:10px"
    },
    {
      "type": "text",
      "value": "Prendre une photo",
      "exclude_from_translation": "icon: camera;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "obs_video",
      "condition": "@field.type_observation == 'par_video'",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "parameter_list": "variant: compact;\nsrc: audio/bHumains/Obser_video_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;margin:10px"
    },
    {
      "type": "text",
      "value": "Filmer une observation",
      "style_list": "icon: videocam;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "obs_text",
      "condition": "@field.type_observation == 'par_text'",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "parameter_list": "variant: compact;\nsrc: audio/bHumains/Obser_text_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;margin:10px"
    },
    {
      "type": "text_area",
      "name": "obs_text",
      "value": "@field.obs_text",
      "action_list": "changed | set_field: obs_text : this.value;",
      "parameter_list": "placeholder: Saisissez vos remarques...;multiline: true;",
      "style_list": "rows: 4; margin: 0 15px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_completed",
      "value": "@global.btn_continue",
      "action_list": "click | emit: completed",
      "parameter_list": "style: navigation;\ndisabled: !@field.type_observation",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}