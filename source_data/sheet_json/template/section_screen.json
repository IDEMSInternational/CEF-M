{
  "flow_type": "template",
  "flow_name": "section_screen",
  "status": "released",
  "rows": [
    {
      "type": "title ",
      "value": "Choix de la composante"
    },
    {
      "type": "html",
      "value": "<div style=\"text-align: center; margin-bottom: 20px; color: #555555; font-size: 14px;\"> Veuillez sélectionner la section sur laquelle vous souhaitez travailler : </div>"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: flex; justify-content: center; align-items: center; width: 100%; padding: 10px;"
    },
    {
      "type": "radio_button_grid",
      "name": "section_step",
      "value": "@fields.section_step",
      "parameter_list": "answer_list: @data.differrentes_sections; style: secondary; item_width: 180px; grid_gap: 12px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red; font-size: 13px; text-align: center; display: block;\">Veuillez faire un choix pour continuer !</span>\t",
      "condition": "@fields.attempt_submit && !@fields.section_step"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "button",
      "value": "Continuer",
      "action_list": "click | set_field: section_step : @local.section_step;\nclick | go_to: planification_anl",
      "condition": "@local.section_step == 'planification'",
      "style_list": "flex: 1; border-radius: 8px; font-weight: bold;"
    },
    {
      "type": "button",
      "value": "Continuer",
      "action_list": "click | set_field: section_step : @local.section_step;\n\nclick | go_to: suivi_anl",
      "condition": "@local.section_step == 'suivi'",
      "style_list": "flex: 1; border-radius: 8px; font-weight: bold;"
    },
    {
      "type": "button",
      "value": "Continuer",
      "action_list": "click | set_field: section_step : @local.section_step;\n\nclick | go_to: auth",
      "condition": "@local.section_step == 'evaluation'"
    },
    {
      "type": "end_display_group"
    }
  ]
}