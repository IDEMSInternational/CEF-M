{
  "flow_type": "template",
  "flow_name": "besoins_humains_page7",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "RENDEMENTS ESTIMÉS"
    },
    {
      "name": "rend_mais",
      "value": "@calc(@field.type_menage_id == 'HRE-LH' ? 2427 : (@field.type_menage_id == 'HRE' ? 2081 : (@field.type_menage_id == 'MRE' ? 1888 : 1298)))"
    },
    {
      "name": "rend_mil",
      "value": "@calc(@field.type_menage_id == 'HRE-LH' ? 884 : (@field.type_menage_id == 'HRE' ? 668 : (@field.type_menage_id == 'MRE' ? 697 : 524)))"
    },
    {
      "name": "rend_sorgho",
      "value": "@calc(@field.type_menage_id == 'HRE-LH' ? 1107 : (@field.type_menage_id == 'HRE' ? 871 : (@field.type_menage_id == 'MRE' ? 907 : 650)))"
    },
    {
      "type": "begin_display_group",
      "name": "info_rendement",
      "style_list": "background: #f8f9fa; padding: 20px;  margin: 15px;"
    },
    {
      "type": "html",
      "value": "<h3 style=\"color: #1e3656; margin: 0 0 10px 0; font-size: 16px;\">VOS CAPACITÉS DE PRODUCTION</h3>"
    },
    {
      "type": "html",
      "value": "<p style=\"color: #666; font-size: 13px;\">Basé sur votre profil <b>@field.final_upa_type </b>, voici vos rendements moyens attendus :</p>"
    },
    {
      "type": "end_display_group"
    },
    {
