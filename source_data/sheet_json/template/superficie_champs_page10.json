{
  "flow_type": "template",
  "flow_name": "superficie_champs_page10",
  "status": "released",
  "rows": [
    {
      "type": "subtitle",
      "value": "**La diversité culturale dans la parcelle  N⁰@fields.num_parcelle de @fields.nom_champ**"
    },
    {
      "type": "begin_data_items",
      "value": "@data.cult_princip",
      "parameter_list": "filter: @item.name == @fields.cult_princip"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width:150px; height:150px; "
    },
    {
      "type": "text",
      "value": "@item.name"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "Comptez et renseignez le nombre d'arbres dans la parcelle N⁰@fields.num_parcelle "
    },
    {
      "type": "audio",
      "name": "audio_10_1",
      "parameter_list": "variant: compact;\nsrc: audio/Superficie/nbre_arbre_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/arbre.jpg",
      "style_list": "width:100px; height:100px; "
    },
    {
      "type": "html",
      "name": "html_text",
      "value": "<p style=\"color: black;\"> Ecrivez 0 s'il n'y a aucun arbre </p>"
    },
    {
      "type": "text_box",
      "name": "nombre_arbre",
      "value": "@fields.nombre_arbre",
      "action_list": "changed | set_field: nombre_arbre : this.value;",
      "parameter_list": "number_input: true\nplaceholder: Entrez le nombre;",
      "condition": "!!@fields.nombre_arbre",
      "exclude_from_translation": true
    },
    {
      "type": "text_box",
      "name": "nombre_arbre",
      "action_list": "changed | set_field: nombre_arbre : this.value;",
      "parameter_list": "number_input: true;\nplaceholder: Entrez le nombre;",
      "condition": "!@fields.nombre_arbre",
      "exclude_from_translation": true
    },
    {
      "type": "html",
      "name": "html_text",
      "value": "<p style=\"color: red;\"> @global.warning_message </p>",
      "condition": "!@fields.nombre_arbre"
    },
    {
      "name": "valid_nombre_arbre",
      "value": "@calc((/^\\d+$/.test(@local.nombre_arbre) && @local.nombre_arbre>= 0 ) || @local.nombre_arbre == '' || !@local.nombre_arbre)",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "@global.validite_nombre",
      "condition": "!@local.valid_nombre_arbre",
      "exclude_from_translation": true,
      "style_list": "color: #FF0000;\nfont-size: 14px"
    },
    {
      "type": "begin_display_group",
      "condition": "@calc(@fields.nombre_arbre > 0)"
    },
    {
      "type": "text",
      "value": "Ecrivez le(s) nom(s) des arbres se trouvant dans la parcelle N⁰@fields.num_parcelle"
    },
    {
      "type": "audio",
      "name": "audio_10_2",
      "parameter_list": "variant: compact;\nsrc: audio/Superficie/nom_arbre_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "nom_arbre",
      "value": "@fields.nom_arbre",
      "action_list": "changed | set_field: nom_arbre : this.value;",
      "parameter_list": "placeholder: Entrez le nom de l'arbre;",
      "condition": "@fields.nombre_arbre  > 0"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "exclude_from_translation": "padding: 12px 24px;"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.nombre_arbre  ",
      "exclude_from_translation": true
    },
    {
      "type": "round_button",
      "name": "page10_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page10_button_continue",
      "value": "Continuer",
      "action_list": "click | set_field: @calc('nombre_arbre_parcelle_N' + @fields.num_parcelle) : @fields.nombre_arbre;\nclick | set_field: @calc('nom_arbre_parcelle_N' + @fields.num_parcelle) : @fields.nom_arbre;\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled"
    },
    {
      "type": "end_display_group"
    }
  ]
}