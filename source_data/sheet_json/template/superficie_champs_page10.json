{
  "flow_type": "template",
  "flow_name": "superficie_champs_page10",
  "status": "released",
  "rows": [
    {
      "name": "valid_cult_asso",
      "value": "@calc(!!@fields.coton || !!@fields.mais || !!@fields.mil || !!@fields.sorgho || !!@fields.arachide || !!@fields.fourrage || !!@fields.fonio || !!@fields.riz || !!@fields.sesame || !!@fields.wauandzou || !!@fields.patate_douce || !!@fields.bissap || !!@fields.autre_culture1 || !!@fields.autre_culture2)"
    },
    {
      "name": "valid_autre_text1",
      "value": "@calc(!@fields.autre_culture1 || (!!@fields.autre_cult_asso1 && @fields.autre_cult_asso1.trim() !== ''))"
    },
    {
      "name": "valid_autre_text2",
      "value": "@calc(!@fields.autre_culture2 || (!!@fields.autre_cult_asso2 && @fields.autre_cult_asso2.trim() !== ''))"
    },
    {
      "name": "completed_enabled",
      "value": "@calc(!!@fields.association_oui_non && (@fields.association_oui_non === 'non' || (@fields.association_oui_non === 'oui' && @local.valid_cult_asso && @local.valid_autre_text1 && @local.valid_autre_text2)))"
    },
    {
      "name": "cult_asso_selected",
      "value": "@calc([@fields.coton ? 'coton' : null, @fields.mais ? 'mais' : null, @fields.mil ? 'mil' : null, @fields.sorgho ? 'sorgho' : null, @fields.arachide ? 'arachide' : null, @fields.fourrage ? 'fourrage' : null, @fields.fonio ? 'fonio' : null, @fields.riz ? 'riz' : null, @fields.sesame ? 'sesame' : null, @fields.wauandzou ? 'wauandzou' : null, @fields.patate_douce ? 'patate_douce' : null, @fields.bissap ? 'bissap' : null, @fields.autre_culture1 ? @fields.autre_cult_asso1 : null, @fields.autre_culture2 ? @fields.autre_cult_asso2 : null].filter(Boolean).join(','))"
    },
    {
      "type": "title",
      "value": "**Cultures associées dans la parcelle N⁰@fields.num_parcelle de @fields.nom_champ**"
    },
    {
      "type": "begin_data_items",
      "value": "@data.cult_princip",
      "parameter_list": "filter: @item.name == @fields.cult_princip"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width: 80%; object-fit: contain;\n"
    },
    {
      "type": "html",
      "value": "<span style=\"font-size: 16px; font-weight: bold; color: #1e3656;\">Culture principale : @item.name</span>"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: block; width: 100%; margin-top: 10px; padding: 10px; background: #f4f7fc;"
    },
    {
      "type": "html",
      "value": "<label style=\"color: #1e3656; font-weight: bold;\"><span style=\"color: red;\">*</span> D'autre(s) culture(s) sont-elles associées avec @fields.cult_princip ?</label>"
    },
    {
      "type": "audio",
      "name": "audio_11_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/asso_yesno_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: block; width: 100%; margin-top: 10px; padding: 10px;"
    },
    {
      "type": "image",
      "value": "images/association.jpg",
      "style_list": "width: 80%; object-fit: contain;\n\n"
    },
    {
      "type": "radio_button_grid",
      "name": "association_oui_non\n",
      "value": "@fields.association_oui_non\n",
      "action_list": "changed | set_field: association_oui_non\n: this.value;",
      "parameter_list": "answer_list: @data.oui_non;\nvariant: flex; item_width: 100px; grid_gap: 10px; style: secondary;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "html",
      "name": "html_text",
      "value": "<span style=\"color: red; font-size: 13px;\">La sélection est obligatoire !</span>",
      "condition": "@fields.attempt_submit_p11 && !@fields.association_oui_non"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.association_oui_non == 'oui'"
    },
    {
      "type": "html",
      "value": "<label style=\"color: #1e3656; font-weight: bold;\"><span style=\"color: red;\">*</span> Sélectionnez la/les culture(s) associée(s) :</label>"
    },
    {
      "type": "audio",
      "name": "audio_11_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/cult_asso_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_data_items",
      "value": "@data.culture_association",
      "parameter_list": "filter: @fields.association_oui_non == 'oui'"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.association_oui_non == 'oui'",
      "style_list": "display: flex; align-items: center; grid_gap: 12px; margin-bottom: 10px; padding: 8px 12px;"
    },
    {
      "type": "image",
      "name": "img_item",
      "value": "@item.image",
      "style_list": "width: 50px; height: 50px; object-fit: contain; flex-shrink: 0;"
    },
    {
      "type": "simple_checkbox",
      "name": "@item.name",
      "value": "@fields.@item.name",
      "action_list": "changed | set_field: @item.name: !@fields.@item.name;",
      "parameter_list": "label_text: @item.text;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.autre_culture1 == true && @fields.association_oui_non == 'oui'",
      "style_list": "display: block; width: 100%; margin-top: 15px; padding: 12px; background: #f8f9fa;"
    },
    {
      "type": "html",
      "value": "<label style=\"color: #1e3656; font-weight: bold;\"><span style=\"color: red;\">*</span> Écrivez le nom de la 1ère culture associée spécifique :</label>"
    },
    {
      "type": "audio",
      "name": "audio_11_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/autre_cult_nom1_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "text_box",
      "name": "autre_cult_asso1",
      "value": "@fields.autre_cult_asso1",
      "action_list": "changed | set_field: autre_cult_asso1 : this.value;",
      "parameter_list": "max_length: 30;\nplaceholder: Entrez le nom de la culture;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red; font-size: 13px;\">Veuillez préciser le nom de la culture !</span>",
      "condition": "@fields.attempt_submit_p11 && @fields.association_oui_non == 'oui' && @fields.autre_culture1 == true && !@fields.autre_cult_asso1"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.autre_culture1 == true && @fields.association_oui_non == 'oui' && @fields.autre_culture2 == true",
      "style_list": "display: block; width: 100%; margin-top: 15px; padding: 12px; background: #f8f9fa;"
    },
    {
      "type": "html",
      "value": "<label style=\"color: #1e3656; font-weight: bold;\"><span style=\"color: red;\">*</span> Écrivez le nom de la 2ème culture associée spécifique :</label>"
    },
    {
      "type": "audio",
      "name": "audio_11_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/autre_cult_nom2_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "text_box",
      "name": "autre_cult_asso2",
      "value": "@fields.autre_cult_asso2",
      "action_list": "changed | set_field: autre_cult_asso2 : this.value;",
      "parameter_list": "max_length: 30;\nplaceholder: Entrez le nom de la culture;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red; font-size: 13px;\">Veuillez préciser le nom de la culture !</span>",
      "condition": "@fields.attempt_submit_p11 && @fields.association_oui_non == 'oui' && @fields.autre_culture2 == true && !@fields.autre_cult_asso2"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "exclude_from_translation": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page11_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page11_button_continue",
      "value": "Continuer",
      "action_list": "click | set_field: @calc('association_parcelle_N' + @fields.num_parcelle) : @fields.association_oui_non;\n        click | set_field: @calc('cult_asso_selected_parcelle_N' + @fields.num_parcelle) : @local.cult_asso_selected;\n        click | set_field: @calc('autre_cult_asso1_parcelle_N' + @fields.num_parcelle) : @fields.autre_cult_asso1;\n        click | set_field: @calc('autre_cult_asso2_parcelle_N' + @fields.num_parcelle) : @fields.autre_cult_asso2;\n        click | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled"
    },
    {
      "type": "end_display_group"
    }
  ]
}