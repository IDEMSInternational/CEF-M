{
  "flow_type": "template",
  "flow_name": "section_fumure_page8",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "name": "page_title"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "html",
      "name": "superficie_exploitation_label",
      "value": "<span style=\"color: red;\">*</span>  @global.superficie_exploitation_label",
      "style_list": "font-size:20px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/superf_unit.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "superficie_exploitation_hint",
      "value": "@global.superficie_exploitation_hint",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "name": "valid_superficie_exploitation",
      "value": "@calc(!!@fields.superficie_exploitation && @fields.superficie_exploitation != \"\" && @fields.superficie_exploitation >= 0)"
    },
    {
      "type": "text_box",
      "name": "superficie_exploitation",
      "value": "@fields.superficie_exploitation",
      "action_list": "changed | set_field: superficie_exploitation: this.value;",
      "parameter_list": "number_input: true"
    },
    {
      "type": "text",
      "name": "error_superficie_exploitation",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_superficie_exploitation",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "html",
      "name": "quantite_fumure_organique_label",
      "value": "<span style=\"color: red;\">*</span>  @global.quantite_fumure_organique_label",
      "style_list": "font-size:20px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/unit_fumure.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "quantite_fumure_organique_hint",
      "value": "@global.quantite_fumure_organique_hint",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "name": "valid_quantite_fumure_organique",
      "value": "@calc(!!@fields.quantite_fumure_organique && @fields.quantite_fumure_organique != \"\" && @fields.quantite_fumure_organique >= 0)"
    },
    {
      "type": "text_box",
      "name": "quantite_fumure_organique",
      "value": "@fields.quantite_fumure_organique",
      "action_list": "changed | set_field: quantite_fumure_organique: this.value;",
      "parameter_list": "number_input: true"
    },
    {
      "type": "text",
      "name": "error_quantite_fumure_organique",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_quantite_fumure_organique",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "html",
      "name": "protion_fertilisable_label",
      "value": "<span style=\"color: red;\">*</span>  @global.portion_fertilisable_label",
      "style_list": "font-size:20px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/superf_fumure.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "portion_fertilisable_hint",
      "value": "@global.portion_fertilisable_hint",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "name": "valid_portion_fertilisable",
      "value": "@calc(!!@fields.portion_fertilisable && @fields.portion_fertilisable != \"\" && @fields.portion_fertilisable >= 0)"
    },
    {
      "type": "text_box",
      "name": "portion_fertilisable",
      "value": "@fields.portion_fertilisable",
      "action_list": "changed | set_field: portion_fertilisable: this.value;",
      "parameter_list": "number_input: true"
    },
    {
      "type": "text",
      "name": "error_portion_fertilisable",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && (@fields.portion_fertilisable == \"\" || !@fields.portion_fertilisable)",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "text",
      "name": "error_portion_too_big",
      "value": "La réponse doit être inférieure ou égale à la superficie totale (@fields.superficie_exploitation ha)",
      "condition": "@fields.portion_fertilisable > @fields.superficie_exploitation",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "name": "completed_enabled",
      "value": "@local.valid_superficie_exploitation && @local.valid_quantite_fumure_organique && @local.valid_portion_fertilisable"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_8_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_8_button_continue",
      "value": "@global.btn_continue",
      "action_list": "click | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}