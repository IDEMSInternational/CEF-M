{
  "flow_type": "template",
  "flow_name": "auth",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "Connexion CEF-M",
      "style_list": "text-align: center; font-size: 20px; font-weight: bold; color: #3e1f08; margin-bottom: 8px;"
    },
    {
      "type": "html",
      "value": "<div style=\"font-size: 13px; color: #555; text-align: center; margin-bottom: 20px;\">Veuillez entrer vos identifiants pour accéder à l'application</div>"
    },
    {
      "name": "valid_auth",
      "value": "@calc(Object.values(@data.upaInfo || {}).some(item => String(item.chef_upa || '').trim().toLowerCase() === String(@fields.chef_upa_input || '').trim().toLowerCase() && String(item.phone_number || '').trim() === String(@fields.phone_number_input || '').trim()))"
    },
    {
      "name": "auth_user_data",
      "value": "@calc(Object.values(@data.upaInfo || {}).find(item => String(item.chef_upa || '').trim().toLowerCase() === String(@fields.chef_upa_input || '').trim().toLowerCase() && String(item.phone_number || '').trim() === String(@fields.phone_number_input || '').trim()))"
    },
    {
      "type": "text",
      "value": "Identifiant (Nom du Chef UPA)"
    },
    {
      "type": "text_box",
      "name": "chef_upa_input",
      "value": "@fields.chef_upa_input",
      "action_list": "changed | set_field: chef_upa_input : this.value;",
      "parameter_list": "placeholder: Entrez le nom complet;"
    },
    {
      "type": "text",
      "value": "Numéro de téléphone"
    },
    {
      "type": "text_box",
      "name": "phone_number_input",
      "value": "@fields.phone_number_input",
      "action_list": "changed | set_field: phone_number_input : this.value;"
    },
    {
      "type": "html",
      "value": "<div style=\"background-color: #ffebee; border: 1px solid #ffcdd2; color: #c62828; padding: 10px 14px; border-radius: 8px; font-size: 13px; text-align: center; margin: 16px 8px 0 8px; font-weight: 500;\">⚠️ Identifiant ou numéro de téléphone incorrect !</div>",
      "condition": "@fields.attempt_login && !@local.valid_auth"
    },
    {
      "type": "begin_display_group",
      "style_list": "sticky: bottom; padding: 16px 24px; margin-top: 20px; display: flex; justify-content: center;"
    },
    {
      "type": "button",
      "value": "Se connecter",
      "action_list": "click | set_field: attempt_login : true; \nclick | set_field: logged_user : @local.auth_user_data; \nclick | go_to: acceuil;",
      "condition": "@local.valid_auth",
      "style_list": "width: 100%; font-weight: bold; padding: 14px;"
    },
    {
      "type": "button",
      "value": "Se connecter",
      "action_list": "click | set_field: attempt_login : true",
      "condition": "!@local.valid_auth",
      "style_list": "width: 100%;padding: 14px; opacity: 0.7;                                \n"
    },
    {
      "type": "end_display_group"
    }
  ]
}