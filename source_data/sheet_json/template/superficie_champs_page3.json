{
  "flow_type": "template",
  "flow_name": "superficie_champs_page3",
  "status": "released",
  "rows": [
    {
      "type": "subtitle",
      "value": "**@global.title_campagne**"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@global.campagne_selection"
    },
    {
      "type": "audio",
      "name": "audio_3_1",
      "parameter_list": "variant: compact;\nsrc: audio/Superficie/annee_saison_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "@global.audio_style"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "html",
      "name": "html_text",
      "value": "<p style=\"color: black;\"> @global.note_campagne </p>"
    },
    {
      "type": "date_time_picker",
      "name": "year_campaign",
      "value": "@fields.year_campaign",
      "action_list": "changed | set_local: year_campaign: this.value;",
      "parameter_list": "type: date"
    },
    {
      "type": "html",
      "name": "html_text",
      "value": "<p style=\"color: red;\"> @global.warning_message </p>",
      "condition": "!@local.year_campaign"
    },
    {
      "name": "completed_enabled",
      "value": "@local.year_campaign "
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page3_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page3_button_continue",
      "value": "Continuer",
      "action_list": "click | set_field: year_campaign: @local.year_campaign;\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled"
    },
    {
      "type": "end_display_group"
    }
  ]
}