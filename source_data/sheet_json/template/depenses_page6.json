{
  "flow_type": "template",
  "flow_name": "depenses_page6",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "name": "page_title",
      "value": "@global.petite_depenses"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "text",
      "name": "depense_education",
      "value": "@global.depense_education"
    },
    {
      "type": "text",
      "name": "note_education_annuel",
      "value": "@global.note_education_annuel"
    },
    {
      "type": "image",
      "value": "images/education.jpg"
    },
    {
      "type": "text",
      "name": "note_education_annuel_hint",
      "value": "@global.note_education_annuel_hint",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "html",
      "name": "frais_education_annuel_label",
      "value": "<span style=\"color: red;\">*</span> @global.frais_education_annuel_label",
      "style_list": "font-size:20px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/cfa_tot.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "hint_price",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text_box",
      "name": "frais_education_annuel",
      "value": "@fields.frais_education_annuel",
      "action_list": "changed | set_field : frais_education_annuel: this.value;",
      "parameter_list": "number_input: true"
    },
    {
      "name": "valid_frais_education_annuel",
      "value": "@calc(!!@fields.frais_education_annuel && @fields.frais_education_annuel != \"\" && @fields.frais_education_annuel >= 0)"
    },
    {
      "type": "text",
      "name": "error_frais_education_annuel",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_frais_education_annuel",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "name": "completed_enabled",
      "value": "@local.valid_frais_education_annuel"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_6_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_6_btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_6_btn_continue",
      "value": "@global.btn_continue",
      "action_list": "click | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}