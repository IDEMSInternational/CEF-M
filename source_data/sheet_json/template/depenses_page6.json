{
  "flow_type": "template",
  "flow_name": "depenses_page6",
  "status": "released",
  "rows": [
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "title",
      "name": "depense_education",
      "value": "@global.depense_education"
    },
    {
      "type": "begin_data_items",
      "value": "@data.niveau_scolaire",
      "parameter_list": "filter: @item.name == @fields.current_niveau_scolaire"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width:150px; height:150px; "
    },
    {
      "type": "text",
      "value": "**@item.text**"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "set_field",
      "name": "niveau_text",
      "value": "@item.text"
    },
    {
      "type": "set_field",
      "name": "niveau_label",
      "value": "@item.name",
      "parameter_list": "\n\n\n"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "name": "nombre_enfants_note",
      "value": "**Donnez le nombre d'enfants de l'UPA inscrit au @fields.niveau_text**"
    },
    {
      "type": "audio",
      "name": "audio_6_1",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/nombre_enfants_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "nombre_enfants",
      "value": "@fields.nombre_enfants",
      "action_list": "changed | set_field: nombre_enfants: this.value;",
      "parameter_list": "number_input: true;\nplaceholder: Entrez le nombre d'enfants;"
    },
    {
      "name": "valid_nombre_enfants",
      "value": "@calc((/^\\d+$/.test(@fields.nombre_enfants) && @fields.nombre_enfants >=0 ) || @fields.nombre_enfants == '' || !@fields.nombre_enfants )"
    },
    {
      "type": "text",
      "name": "error_nombre_enfants",
      "value": "@global.error_required_answer",
      "condition": "!@fields.nombre_enfants && @fields.attempt_submit",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "text",
      "value": "@global.validite_nombre",
      "condition": "!@local.valid_nombre_enfants",
      "style_list": "color: #FF0000;\nfont-size: 14px"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "name": " frais_annuel_scolarite_note",
      "value": "**Donnez le frais annuel de scolarité d'un enfant au @fields.niveau_text en drm**"
    },
    {
      "type": "audio",
      "name": "audio_6_2",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/scolarite_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text_box",
      "name": " frais_scolarite",
      "value": "@fields.frais_scolarite",
      "action_list": "changed | set_field:  frais_scolarite: this.value;",
      "parameter_list": "number_input: true;\nplaceholder: Entrez le  frais annuel scolarite;"
    },
    {
      "name": "valid_frais_scolarite",
      "value": "@calc(@fields.frais_scolarite >=0  || @fields.frais_scolarite == '' || !@fields.frais_scolarite )"
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "!@fields.frais_scolarite && @fields.attempt_submit",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "text",
      "value": "@global.validite_nombre",
      "condition": "!@local.valid_frais_scolarite",
      "style_list": "color: #FF0000;\nfont-size: 14px"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "name": "frais_fourniture_note",
      "value": "**Donnez le frais annuel de fourniture scolaire d'un enfant au @fields.niveau_text en drm**"
    },
    {
      "type": "audio",
      "name": "audio_6_3",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/fourniture_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "name": "hint_price",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "html",
      "value": "<p style=\"color: black;\"> Il s'agit des frais de fournitures scolaires (sac, ardoise, crayon, bic, livres, la craie, etc.) d'un enfant  </p>"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text_box",
      "name": "frais_fourniture",
      "value": "@fields.frais_fourniture",
      "action_list": "changed | set_field:  frais_fourniture: this.value;",
      "parameter_list": "number_input: true;\nplaceholder: Entrez le frais des fournitures;"
    },
    {
      "name": "valid_frais_fourniture",
      "value": "@calc( @fields.frais_fourniture >=0 || @fields.frais_fourniture == '' || !@fields.frais_fourniture )"
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "!@fields.frais_fourniture && @fields.attempt_submit",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "text",
      "value": "@global.validite_nombre",
      "condition": "!@local.valid_frais_fourniture",
      "style_list": "color: #FF0000;\nfont-size: 14px"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "name": "frais_deplacement_note",
      "value": "**Donnez les frais quotidiens de déplacement aller-retour entre la maison et l'école d'un enfant du @fields.niveau_text en drm**"
    },
    {
      "type": "audio",
      "name": "audio_6_4",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/transport_jour_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text_box",
      "name": " frais_deplacement",
      "value": "@fields.frais_deplacement",
      "action_list": "changed | set_field:  frais_deplacement: this.value;",
      "parameter_list": "number_input: true;\nplaceholder: Entrez le frais de deplacement;"
    },
    {
      "name": "valid_frais_deplacement",
      "value": "@calc(@fields.frais_deplacement >=0 || @fields.frais_deplacement == '' || !@fields.frais_deplacement )"
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "!@fields.frais_deplacement && @fields.attempt_submit",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "text",
      "value": "@global.validite_nombre",
      "condition": "!@local.valid_frais_deplacement",
      "style_list": "color: #FF0000;\nfont-size: 14px"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "name": "frais_recreation_note",
      "value": "**Donnez le frais quotidien de récreation d'un enfant au @fields.niveau_text en drm**"
    },
    {
      "type": "audio",
      "name": "audio_6_5",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/recreation_jour_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text_box",
      "name": " frais_recreation",
      "value": "@fields.frais_recreation",
      "action_list": "changed | set_field:  frais_recreation: this.value;",
      "parameter_list": "number_input: true;\nplaceholder: Entrez le frais de recreation;"
    },
    {
      "name": "valid_frais_recreation",
      "value": "@calc(@fields.frais_recreation >=0  || @fields.frais_recreation == '' || !@fields.frais_recreation )"
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "!@fields.frais_recreation && @fields.attempt_submit",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "text",
      "value": "@global.validite_nombre",
      "condition": "!@local.valid_frais_recreation",
      "style_list": "color: #FF0000;\nfont-size: 14px"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.nombre_enfants && @fields.frais_scolarite && @fields.frais_fourniture && @fields.frais_deplacement && @fields.frais_recreation"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_6_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_6_btn_attempt_submit",
      "value": "continuer",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page6_button_continue",
      "value": "@global.btn_continue",
      "action_list": "\nclick | set_field: attempt_submit: false;\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}