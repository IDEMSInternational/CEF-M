{
  "flow_type": "template",
  "flow_name": "superficie_champs_page16",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "**Superficie réelle de la parcelle N⁰@fields.num_parcelle de @fields.nom_champ**"
    },
    {
      "type": "text",
      "value": "**Superficie de @fields.cult_princip dans la parcelle N⁰@fields.num_parcelle de @fields.nom_champ**"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "La superficie estimée (ha) était :"
    },
    {
      "type": "text",
      "name": "superficie_estimee",
      "value": "@fields.superficie_parcelle"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "La superficie mesurée (ha) est :"
    },
    {
      "type": "text",
      "name": "superficie_mesuree",
      "value": "@fields.superficie_geo"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "superficie_diff",
      "value": "@calc(Number(@local.superficie_estimee) - Number(@local.superficie_mesuree))",
      "exclude_from_translation": true
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "La différence entre la superficie donnée et la superficie mésurée (ha) est :"
    },
    {
      "type": "text_box",
      "name": "superficie_diff_value",
      "value": "@local.superficie_diff"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "html",
      "value": "<p style=\"color: green;\"> Bonne estimation de la superficie, Bravo! </p>",
      "condition": "@local.superficie_diff < 0.1 || @local.superficie_diff > -0.1"
    },
    {
      "type": "html",
      "value": "<p style=\"color: red;\"> Superficie sur-estimée ! </p>",
      "condition": "@local.superficie_diff > 0.1 "
    },
    {
      "type": "html",
      "value": "<p style=\"color: red;\"> Superficie sous-estimée !</p>",
      "condition": "@local.superficie_diff < -0.1"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "name": "completed_enabled",
      "value": "!@local.superficie_diff",
      "style_list": true
    },
    {
      "type": "round_button",
      "name": "page16_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page16_button_continue",
      "value": "Continuer",
      "action_list": "click | set_field: @calc('superficie_diff_parcelle_N' + @fields.num_parcelle) : @local.superficie_diff;\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled"
    },
    {
      "type": "end_display_group"
    }
  ]
}