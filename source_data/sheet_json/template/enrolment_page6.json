{
  "flow_type": "template",
  "flow_name": "enrolment_page6",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "APPARTENANCE ASSOCIATIVE"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@global.appartenance_coton_note"
    },
    {
      "type": "audio",
      "name": "audio_7_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Enrolement/on_scpc_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/op_coton.jpg",
      "style_list": "width:100px; height:100px; "
    },
    {
      "type": "begin_radio_list",
      "value": "@fields.appartenance_coton",
      "action_list": "changed | set_field : appartenance_coton: this.value;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.oui_non"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list"
    },
    {
      "type": "html",
      "value": "<p style=\"color: red;\"> @global.reponse_obligatoire </p>",
      "condition": "!@fields.appartenance_coton && @fields.attempt_submit"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@global.appartenance_cereale_note"
    },
    {
      "type": "audio",
      "name": "audio_7_2",
      "parameter_list": "variant: button_only;\nsrc: audio/Enrolement/on_op_cereales_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/op_cereales.jpg",
      "style_list": "width:100px; height:100px; "
    },
    {
      "type": "begin_radio_list",
      "value": "@fields.appartenance_cereale",
      "action_list": "changed | set_field : appartenance_cereale: this.value;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.oui_non"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list"
    },
    {
      "type": "html",
      "value": "<p style=\"color: red;\"> @global.reponse_obligatoire </p>",
      "condition": "!@fields.appartenance_cereale && @fields.attempt_submit"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.appartenance_cereale && @fields.appartenance_coton"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_7_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_7_button_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: false;\nclick | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}