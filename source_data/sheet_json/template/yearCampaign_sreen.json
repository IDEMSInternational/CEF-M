{
  "flow_type": "template",
  "flow_name": "yearCampaign_sreen",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "Année de la campagne agricole"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: flex; flex-direction: row; align-items: center; justify-content: flex-start; width: 100%; margin-top: 20px; gap: 10px;"
    },
    {
      "type": "html",
      "value": "<span style=\"color: #d71920; font-weight: bold; margin-right: 4px;\">*</span><span style=\"color: #333333; font-weight: 600; font-size: 20px;\">Sélectionnez l'année de la campagne agricole</span>",
      "style_list": "margin-top: 20px; font-weight: 600;"
    },
    {
      "type": "audio",
      "parameter_list": "variant: button_only;\nsrc: audio/recolte/annee_saison_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "flex-shrink: 0;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "date_time_picker",
      "name": "season_label",
      "value": "@fields.season_label",
      "action_list": "changed | set_field: season_label: this.value;",
      "parameter_list": "type: year;\nmin: 2023; \nmax: @calc(now());"
    },
    {
      "name": "v_year_ok",
      "value": "@calc(!!@field.season_label)"
    },
    {
      "type": "html",
      "value": "<div style=\"width:100%; text-align:center; padding: 20px 0; margin-top:16px; background: #f7fafc; border: 1px dashed #cbd5e0; border-radius: 12px; font-size:18px; font-weight:600; color:#718096;\">📅 Aucune date choisie</div>",
      "condition": "!@local.v_year_ok"
    },
    {
      "type": "html",
      "value": "<div style=\"width:100%; text-align:center; padding: 20px 0; margin-top:16px; background: #e6fffa; border: 2px solid #00adcc; border-radius: 12px; font-size:26px; font-weight:800; color:#00adcc; box-shadow: 0 4px 12px rgba(0,173,204,0.1);\">@field.season_label</div>",
      "condition": "@local.v_year_ok"
    },
    {
      "type": "html",
      "value": "<div style=\"width:100%; color:#d71920; font-size:13px; font-weight:700; margin-top:14px; background: #fff5f5; padding: 10px; border-radius: 6px; border-left: 4px solid #d71920;\">❗ Réponse obligatoire, aucune année indiquée !</div>",
      "condition": "!@local.v_year_ok"
    },
    {
      "type": "text",
      "value": "**@global.num_upa**"
    },
    {
      "type": "text_box",
      "name": "numero_tel_UPA",
      "value": "@fields.numero_tel_UPA",
      "action_list": "changed | set_field: numero_tel_UPA: this.value;",
      "parameter_list": "number_input: true;\nplaceholder: Entrez le numero de telephone "
    },
    {
      "name": "valid_numero_upa",
      "value": "@calc(/^[1-9][0-9]{7}$/.test(@local.numero_tel_UPA)|| @local.numero_tel_UPA == '')"
    },
    {
      "type": "html",
      "name": "error_num_phone",
      "value": "<p style=\"color: red;\"> @global.numero_error </p>",
      "condition": "!@local.valid_numero_upa",
      "style_list": "color: red; font-size: 16px;"
    },
    {
      "name": "completed_enabled",
      "value": "@local.v_year_ok && @local.valid_numero_upa"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 16px 24px;"
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | go_to: scan_creen",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_completed",
      "value": "Continuer",
      "action_list": "click | set_field: season_label: @field.season_label;\nclick | go_to: primaryCrops_screen;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}