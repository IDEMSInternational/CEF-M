{
  "flow_type": "template",
  "flow_name": "depenses_page5",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "name": "page_title",
      "value": "PREVISIONS DES DEPENSES ANNUELLES RECURRENTES"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "text",
      "name": "depense_sante",
      "value": "DEPENSES DE SANTE DE L'ANNEE PROCHAINE DE L'UPA"
    },
    {
      "type": "text",
      "name": "note_frais_sante_approche",
      "value": "Approche d'estimation des dépenses annuelles de santé des membres de l'UPA:"
    },
    {
      "type": "image",
      "value": "images/sante.jpg"
    },
    {
      "type": "text",
      "name": "note_frais_sante_approche_hint",
      "value": "Il s'agit des dépenses de santé des personnes qui résideront dans l'UPA durant plus de 6 mois au cours l'année prochaine\n\nPour chaque personne qui résidera dans l'UPA, il faut prévoir 3000 drm/an comme frais médicaux du traitement d'une maladie très frequente telles que le paludisme, la fière typhoïde et bronchites. \n\nAinsi, le calcul est fait en multipliant 3000 drm par  le nombre de personnes qui résideront dans l'UPA.",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "html",
      "name": "nombre_personne_upa_label",
      "value": "<span style=\"color: red;\">*</span> Donnez le nombre de personnes qui résideront dans l'UPA",
      "style_list": "font-size:20px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/membres.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "hint_price",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text_box",
      "name": "nombre_personne_upa",
      "value": "@fields.nombre_personne_upa",
      "action_list": "changed | set_field : nombre_personne_upa: this.value;",
      "parameter_list": "number_input: true"
    },
    {
      "type": "text",
      "name": "nombre_personne_upa_hint",
      "value": "Il s'agit des personnes qui resideront dans l'UPA au cours de la prochaine nouvelle année",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "name": "valid_nombre_personne_upa",
      "value": "@calc(!!@fields.nombre_personne_upa && @fields.nombre_personne_upa != \"\" && @fields.nombre_personne_upa >= 0)"
    },
    {
      "type": "text",
      "name": "error_nombre_personne_upa",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_nombre_personne_upa",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "name": "frais_sante_annuel",
      "value": "@calc(Number(@fields.nombre_personne_upa * 3000))"
    },
    {
      "name": "note_frais_sante_cfa",
      "value": "@calc(Number(@local.frais_sante_annuel || 0) * 5)"
    },
    {
      "type": "html",
      "value": "<div style=\"background: #FFF3E0; padding: 20px; border-radius: 15px; text-align: center; border: 2px solid #E65100;\">\n  <span style=\"font-size: 16px; color: #6D4C41;\">Montant prévisionnel des dépenses annuelles de santé humaine de l'UPA: \n</span>\n  <h1 style=\"color: #E65100; margin: 10px 0;\">@local.frais_sante_annuel drm</h1>\n  \n  <div style=\"background: #E8F5E9; padding: 10px; border-radius: 10px;\">\n    <span style=\"color: #2E7D32; font-weight: bold; font-size: 20px;\">\n      @local.note_frais_sante_cfa FCFA\n    </span>\n  </div>\n</div>",
      "condition": "@local.valid_nombre_personne_upa"
    },
    {
      "type": "text",
      "name": "note_frais_sante_hint",
      "value": "@global.note_frais_sante_hint",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "name": "completed_enabled",
      "value": "@local.valid_nombre_personne_upa"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_5_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_5_btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_5_btn_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: frais_sante_annuel: @local.frais_sante_annuel;\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}