{
  "flow_type": "template",
  "flow_name": "section_semi_page6",
  "status": "released",
  "rows": [
    {
      "name": "v_current_human",
      "value": "@calc(Number(@field.current_culture_index) + 1)"
    },
    {
      "name": "v_chaux_fmt",
      "value": "@calc(/^\\d+$/.test(@field.quantite_chaux_agricole))"
    },
    {
      "name": "v_chaux_err",
      "value": "@calc(!@local.v_chaux_fmt || Number(@field.quantite_chaux_agricole) < 0)"
    },
    {
      "name": "v_cout_chaux_fmt",
      "value": "@calc(/^\\d+(\\.\\d+)?$/.test(@field.cout_chaux_agricole_nonzero))"
    },
    {
      "name": "v_cout_chaux_err",
      "value": "@calc(!@local.v_cout_chaux_fmt || Number(@field.cout_chaux_agricole_nonzero) < 0)]"
    },
    {
      "type": "begin_display_group",
      "name": "header",
      "style_list": "background: #00adcc; padding: 15px; border-radius: 0 0 15px 15px; margin-bottom: 20px;"
    },
    {
      "type": "html",
      "value": "<div style=\"color: white; font-weight: bold; font-size: 14px;\">CULTURE @local.v_current_human / @field.total_cultures_selected </div>"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "style_list": "width: 100%; display: flex; flex-direction: column; align-items: center; border: 1px solid #FFCC80; border-radius: 12px; background: white; margin-bottom: 10px; overflow: hidden;"
    },
    {
      "type": "image",
      "value": "@calc(['mais','mil','sorgho','coton','arachide','fourrage','fonio','riz','sésame','wouandzou','patate','bissap'].includes((@field.active_culture_name || '').toLowerCase().trim()) ? 'images/' + @field.active_culture_name + '.jpg' : 'images/autre.jpeg')",
      "style_list": "width: 60%; object-fit: contain;"
    },
    {
      "type": "text",
      "value": "<h3 style='color: black; margin: 10px 0;'>Culture : <span style='color: #e3a730;'>@field.active_culture_name</span></h3>",
      "style_list": "font-weight: bold; font-size: 18px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "html",
      "value": "<div style=\"color: #e67e22; font-weight: bold; font-size: 14px; margin-bottom: 10px;\">APPORT CHAUX AGRICOLE </div>"
    },
    {
      "type": "begin_display_group",
      "name": "grp_quantite_chaux",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "name": "\naud_chaux_fr",
      "parameter_list": "variant: button_only;\n\nsrc: audio/semis/q_chaux_agri_fr.mp3;\n\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red;\">*</span> Quantité chaux (sac)",
      "style_list": "font-weight: bold;"
    },
    {
      "type": "text",
      "value": "*Mettez 0 si aucune chaux* <span style=\"font-size: 12px; color: gray;\"></span>",
      "style_list": "font-size: 14px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/sac.jpg",
      "style_list": "width:100px; height:100px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "quantite_chaux_agricole",
      "value": "@field.quantite_chaux_agricole",
      "action_list": "changed | set_field: quantite_chaux_agricole: this.value;",
      "parameter_list": "number_input: true;\n\nplaceholder: Nombre de sacs;"
    },
    {
      "type": "text",
      "value": "Mettez une valeur positive<span style=\"font-size:11px;\"></span>",
      "condition": "@local.v_fum_err",
      "style_list": "font-size: 12px; color: red;"
    },
    {
      "type": "begin_display_group",
      "name": "cout_chaux_zero",
      "condition": "@calc(Number(@field.quantite_chaux_agricole) == 0)",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "name": "aud_chaux_z_fr",
      "parameter_list": "variant: button_only;\n\nsrc: audio/semis/cout_transport_fr.mp3;\n\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "html",
      "value": "Coût chaux (Dram) <span style=\"font-size: 14px; color: #555;\"></span>",
      "style_list": "font-weight: bold;"
    },
    {
      "type": "text",
      "value": "*Rappel : 1 dram = 5 FCFA*",
      "style_list": "font-size: 14px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px;"
    },
    {
      "type": "text_box",
      "value": 0,
      "parameter_list": "disabled:true;"
    },
    {
      "type": "text",
      "value": "Coût bloqué à 0 car aucune chaux apportée",
      "style_list": "font-size: 12px; color: #999;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "cout_chaux_nonzero",
      "condition": "@calc(Number(@field.quantite_chaux_agricole) > 0)",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "name": "aud_chaux_nz_fr",
      "parameter_list": "variant: button_only;\n\nsrc: audio/semis/cout_chaux_agri_fr.mp3;\n\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red;\">*</span> Coût chaux (Dram) <span style=\"font-size: 14px; color: #555;\"></span>",
      "style_list": "font-weight: bold;"
    },
    {
      "type": "text",
      "value": "*Rappel : 1 dram = 5 FCFA*",
      "style_list": "font-size: 14px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width: 80px; object-fit: contain;"
    },
    {
      "type": "text_box",
      "name": "cout_chaux_agricole_nonzero",
      "value": "@field.cout_chaux_agricole_nonzero",
      "action_list": "changed | set_field: cout_chaux_agricole_nonzero: this.value;",
      "parameter_list": "number_input: true;\n\nplaceholder: Montant en Dram;"
    },
    {
      "type": "text",
      "value": "Mettez une valeur positive.<br><span style=\"font-size:11px;\"></span>",
      "condition": "@local.v_cout_chaux_err",
      "style_list": "font-size: 12px; color: red;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "v_val_chaux_nz",
      "value": "@calc(Number(@field.cout_chaux_agricole_nonzero) || 0)"
    },
    {
      "name": "v_final_chaux",
      "value": "@calc(Number(@field.quantite_chaux_agricole) == 0 ? 0 : @local.v_val_chaux_nz)"
    },
    {
      "name": "v_page4_valid",
      "value": "@calc(@local.v_chaux_fmt && Number(@field.quantite_chaux_agricole) >= 0 && (Number(@field.quantite_chaux_agricole) == 0 || (@local.v_cout_chaux_fmt && Number(@field.cout_chaux_agricole_nonzero) >= 0)))"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_completed",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: cout_chaux_agricole : @local.v_final_chaux;\n\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.v_page4_valid",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}