{
  "flow_type": "template",
  "flow_name": "section_semi_page6",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "name": "page_title",
      "value": "PRÉCISER LES CULTURES"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "name": "valid_sc_name_1",
      "value": "@calc(!@fields.secondary_crop_1 || (!!@fields.sc_name_1 && @fields.sc_name_1.trim() !== \"\"))"
    },
    {
      "name": "valid_sc_name_2",
      "value": "@calc(!@fields.secondary_crop_2 || (!!@fields.sc_name_2 && @fields.sc_name_2.trim() !== \"\"))"
    },
    {
      "name": "completed_enabled",
      "value": "@local.valid_sc_name_1 && @local.valid_sc_name_2"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.secondary_crop_1"
    },
    {
      "type": "html",
      "name": "sc_name_1_label",
      "value": "<span style=\"color: red;\">*</span> @global.sc_name_1_label",
      "style_list": "font-size:20px;"
    },
    {
      "type": "audio",
      "name": "audio_6_1",
      "parameter_list": "variant: compact;\nsrc: audio/semis/cult_second_nom1_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/autre_cult_1.jpg",
      "condition": "@fields.secondary_crop_1",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "sc_name_1_hint",
      "value": "@global.sc_name_other_hint",
      "condition": "@fields.secondary_crop_1",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text_box",
      "name": "sc_name_1",
      "value": "@fields.sc_name_1",
      "action_list": "changed | set_field: sc_name_1: this.value;",
      "condition": "@fields.secondary_crop_1"
    },
    {
      "type": "text",
      "name": "error_sc_name_1",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_sc_name_1",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.secondary_crop_2"
    },
    {
      "type": "html",
      "name": "sc_name_2_label",
      "value": "<span style=\"color: red;\">*</span> @global.sc_name_2_label",
      "style_list": "font-size:20px;"
    },
    {
      "type": "audio",
      "name": "audio_6_2",
      "parameter_list": "variant: compact;\nsrc: audio/semis/cult_second_nom2_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/autre_cult_2.jpg",
      "condition": "@fields.secondary_crop_2",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "sc_name_2_hint",
      "value": "@global.sc_name_other_hint",
      "condition": "@fields.secondary_crop_2",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text_box",
      "name": "sc_name_2",
      "value": "@fields.sc_name_2",
      "action_list": "changed | set_field: sc_name_2: this.value;",
      "condition": "@fields.secondary_crop_2"
    },
    {
      "type": "text",
      "name": "error_sc_name_2",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_sc_name_2",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "name": "completed_enabled",
      "value": "@local.valid_sc_name_1 && @local.valid_sc_name_2"
    },
    {
      "name": "final_sc_list",
      "value": "@calc([@fields.fonio?'fonio':null, @fields.rice?'riz':null, @fields.sesame?'sesame':null, @fields.wouandzou?'wouandzou':null, @fields.patate_douce?'patate_douce':null, @fields.bissap?'bissap':null, @fields.secondary_crop_1?@fields.sc_name_1:null, @fields.secondary_crop_2?@fields.sc_name_2:null].filter(v=>v!==null).join(','))"
    },
    {
      "name": "final_sc_count",
      "value": "@calc([@fields.fonio,@fields.rice,@fields.sesame,@fields.wouandzou,@fields.patate_douce,@fields.bissap,@fields.secondary_crop_1,@fields.secondary_crop_2].filter(v=>!!v).length)"
    },
    {
      "name": "current_sc",
      "value": "@calc(@fields.fonio ? 'fonio' :(@fields.rice ? 'riz' :(@fields.sesame ? 'sesame' :(@fields.wouandzou ? 'wouandzou' :(@fields.patate_douce ? 'patate_douce' :(@fields.bissap ? 'bissap' :(@fields.secondary_crop_1 ? @fields.sc_name_1 :(@fields.secondary_crop_2 ? @fields.sc_name_2 :''))))))))"
    },
    {
      "name": "sc_loop_idx",
      "value": 0
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_6_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_6_btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_6_btn_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: secondary_crops_selected : @local.final_sc_list;\nclick | set_field: secondary_crops_selected_count : @local.final_sc_count;\nclick | set_field: secondary_crop_loop_idx : @local.sc_loop_idx;\nclick | set_field: current_secondary_crop : @local.current_sc;\nclick | set_field: attempt_submit: false;\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}