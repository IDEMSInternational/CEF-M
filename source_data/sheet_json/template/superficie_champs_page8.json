{
  "flow_type": "template",
  "flow_name": "superficie_champs_page8",
  "status": "released",
  "rows": [
    {
      "type": "begin_display_group",
      "parameter_list": "filter: @fields.cult_princip"
    },
    {
      "type": "subtitle",
      "value": "**Variété utilisée de @fields.cult_princip dans la parcelle N⁰@fields.num_parcelle de @fields.nom_champ**"
    },
    {
      "type": "audio",
      "name": "audio_8_1",
      "parameter_list": "variant: compact;\nsrc: audio/Superficie/var_seme_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "html",
      "value": "<p style=\"color: black;\">@global.variete_hint </p>"
    },
    {
      "type": "text_box",
      "name": "nom_variete",
      "value": "@fields.nom_variete",
      "action_list": "changed | set_field: nom_variete: this.value;",
      "parameter_list": "max_length: 30;\nplaceholder:Écrivez le nom de la variété cultivée",
      "exclude_from_translation_1": true
    },
    {
      "type": "html",
      "value": "<p style=\"color: red;\"> @global.warning_message </p>",
      "condition": "!@local.nom_variete"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "**Le type de variété de @fields.cult_princip dans la parcelle N⁰@fields.num_parcelle**"
    },
    {
      "type": "audio",
      "name": "audio_8_2",
      "parameter_list": "variant: compact;\nsrc: audio/Superficie/var_type_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "Sélectionnez le type de variété de @fields.cult_princip "
    },
    {
      "type": "begin_radio_list",
      "name": "type_variete",
      "value": "@fields.type_variete",
      "action_list": "changed | set_field: type_variete: this.value;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.type_variete"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list"
    },
    {
      "type": "html",
      "name": "html_text",
      "value": "<p style=\"color: red;\"> @global.warning_message </p>",
      "condition": "!@local.type_variete"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "exclude_from_translation": "padding: 12px 24px;"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.nom_variete && @fields.type_variete",
      "exclude_from_translation": true
    },
    {
      "type": "round_button",
      "name": "page8_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page8_button_continue",
      "value": "Continuer",
      "action_list": "click | set_field: @calc('nom_variete_parcelle_N⁰' + @fields.num_parcelle) : @fields.nom_variete;\nclick | set_field: @calc('type_variete_parcelle_N⁰' + @fields.num_parcelle) : @fields.type_variete;\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled"
    },
    {
      "type": "end_display_group"
    }
  ]
}