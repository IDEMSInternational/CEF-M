{
  "flow_type": "template",
  "flow_name": "cultures_page3",
  "status": "released",
  "rows": [
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_data_items",
      "value": "@data.planif_cultures_primaires",
      "parameter_list": "filter: @item.name == @fields.culture_label"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width:150px; height:150px; "
    },
    {
      "type": "text",
      "value": "**@item.text**"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "title",
      "value": "PREVISION SUPERFICIE"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "**@fields.culture_label : Superficie totale prévisonnelle (ha)**"
    },
    {
      "type": "audio",
      "name": "audio_3_1",
      "parameter_list": "variant: button_only;\nsrc: audio/semis/sup_culture_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/superf_unit.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "*Superficie cumulée de toutes les parcelles de @fields.culture_label*",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text_box",
      "name": "superficie_ha_prevue",
      "value": "@fields.superficie_ha_prevue",
      "action_list": "changed | set_field : superficie_ha_prevue: this.value;",
      "parameter_list": "number_input: true;\nplaceholder: Écrivez la superficie;"
    },
    {
      "name": "valid_superficie_ha_prevue",
      "value": "@calc(!!@fields.superficie_ha_prevue && @fields.superficie_ha_prevue != ' ' && @fields.superficie_ha_prevue > 0)"
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_superficie_ha_prevue",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "**@fields.culture_label: Superficie prévisionnelle à labourer par prestation (ha)**"
    },
    {
      "type": "audio",
      "name": "audio_3_2",
      "parameter_list": "variant: button_only;\nsrc: audio/semis/sup_labour_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/superf_unit.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "*Mettez 0 si aucune superficie*",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text_box",
      "name": "superficie_prevue_labour",
      "value": "@fields.superficie_prevue_labour",
      "action_list": "changed | set_field : superficie_prevue_labour: this.value;",
      "parameter_list": "number_input: true;\nplaceholder: Écrivez la superficie;"
    },
    {
      "name": "valid_superficie_prevue_labour",
      "value": "@calc(!!@fields.superficie_prevue_labour && @fields.superficie_prevue_labour != ' ' && @fields.superficie_prevue_labour >= 0)"
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_superficie_prevue_labour",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "condition": "@local.superficie_prevue_labour == 0"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "**Coût prévisionnel de labour par prestation (drm)**"
    },
    {
      "type": "audio",
      "name": "audio_3_3",
      "parameter_list": "variant: button_only;\nsrc: audio/semis/cout_labour_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text_box",
      "name": "cout_prevu_superficie_labour_zero",
      "value": "@calc(Number(0))",
      "action_list": "changed | set_field : cout_prevu_superficie_labour_zero: this.value;",
      "parameter_list": "number_input: true;\nplaceholder: Écrivez le nombre;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "condition": "@local.superficie_prevue_labour != 0"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "**Coût prévisionnel de labour par prestation (drm)**"
    },
    {
      "type": "audio",
      "name": "audio_3_4",
      "parameter_list": "variant: button_only;\nsrc: audio/semis/cout_labour_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text_box",
      "name": "cout_prevu_superficie_labour_nonzero",
      "value": "@fields.cout_prevu_superficie_labour_nonzero",
      "action_list": "changed | set_field : cout_prevu_superficie_labour_nonzero: this.value;\n",
      "parameter_list": "number_input: true;\nplaceholder: Écrivez le nombre;"
    },
    {
      "name": "valid_cout_prevu_superficie_labour_nonzero",
      "value": "@calc(!!@fields.cout_prevu_superficie_labour_nonzero && @fields.cout_prevu_superficie_labour_nonzero != ' ' && @fields.cout_prevu_superficie_labour_nonzero >= 0)"
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_cout_prevu_superficie_labour_nonzero",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "completed_enabled",
      "value": "@local.valid_superficie_ha_prevue && @local.valid_superficie_prevue_labour && @local.valid_cout_prevu_superficie_labour_nonzero"
    },
    {
      "name": "cout_prevue_superficie_labour",
      "value": "@calc(Number(@fields.cout_prevu_superficie_labour_zero) || Number(@fields.cout_prevu_superficie_labour_nonzero))"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_3_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_3_btn_attempt_submit",
      "value": "Continuer",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_3_btn_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: cout_prevue_superficie_labour : @local.cout_prevue_superficie_labour;\nclick | set_field: cout_prevue_superficie_labour_@fields.culture_label : @local.cout_prevue_superficie_labour;\nclick | set_field: superficie_prevue_labour_@fields.culture_label : @fields.superficie_prevue_labour;\nclick | set_field: superficie_ha_prevue_@fields.culture_label : @fields.superficie_ha_prevue;\nclick | set_field: attempt_submit: false;\nclick | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}