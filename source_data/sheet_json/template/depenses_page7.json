{
  "flow_type": "template",
  "flow_name": "depenses_page7",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "@global.montant_previsionnel_note"
    },
    {
      "type": "begin_data_items",
      "value": "@data.niveau_scolaire",
      "parameter_list": "filter: @item.name == @fields.current_niveau_scolaire"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width:150px; height:150px; "
    },
    {
      "type": "text",
      "value": "**@item.text**"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "text",
      "name": "note_frais_education_enfants",
      "value": "**Frais annuels des @fields.nombre_enfants enfants du @fields.niveau_text de l'UPA sont**"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "**Scolarité annuelle**"
    },
    {
      "type": "audio",
      "name": "audio_7_1",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/scolarite_annuel_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "set_field",
      "name": "total_frais_scolarite",
      "value": "@calc(Math.round(@fields.nombre_enfants * @fields.frais_scolarite))"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "hint_price",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "html",
      "value": "<div style=\"background: #FFF3E0; padding: 20px; border-radius: 15px; text-align: center; border: 2px solid #E65100;\">\n  <span style=\"font-size: 16px; color: #6D4C41;\"> Scolarité annuelle: </span>\n  \n  <div style=\"background: #E8F5E9; padding: 10px; border-radius: 10px;\">\n    <span style=\"color: #2E7D32; font-weight: bold; font-size: 20px;\">\n     @fields.total_frais_scolarite drm\n    </span>\n  </div>\n</div>"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "**Fourniture scolaire**"
    },
    {
      "type": "audio",
      "name": "audio_7_2",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/fourniture_annuel_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "set_field",
      "name": "total_frais_fourniture",
      "value": "@calc(Math.round(@fields.nombre_enfants * @fields.frais_fourniture))"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "hint_price",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "html",
      "value": "<div style=\"background: #FFF3E0; padding: 20px; border-radius: 15px; text-align: center; border: 2px solid #E65100;\">\n  <span style=\"font-size: 16px; color: #6D4C41;\"> Fourniture scolaire: </span>\n  \n  <div style=\"background: #E8F5E9; padding: 10px; border-radius: 10px;\">\n    <span style=\"color: #2E7D32; font-weight: bold; font-size: 20px;\">\n     @fields.total_frais_fourniture drm\n    </span>\n  </div>\n</div>"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "**Transport scolaire**"
    },
    {
      "type": "audio",
      "name": "audio_7_3",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/transport_annuel_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "set_field",
      "name": "total_frais_deplacement",
      "value": "@calc(Math.round(@fields.nombre_enfants * @fields.frais_deplacement * 160.0))"
    },
    {
      "type": "html",
      "value": "<p style=\"color: black;\"> Les frais annuels de déplacement sont calculés en multipliant les frais journaliers par 160 jours (5 jours par semaine pendant 8 mois) </p>"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "hint_price",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "html",
      "value": "<div style=\"background: #FFF3E0; padding: 20px; border-radius: 15px; text-align: center; border: 2px solid #E65100;\">\n  <span style=\"font-size: 16px; color: #6D4C41;\"> Transport scolaire: </span>\n  \n  <div style=\"background: #E8F5E9; padding: 10px; border-radius: 10px;\">\n    <span style=\"color: #2E7D32; font-weight: bold; font-size: 20px;\">\n     @fields.total_frais_deplacement drm\n    </span>\n  </div>\n</div>"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "**Frais récréation**"
    },
    {
      "type": "audio",
      "name": "audio_7_4",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/recreation_annuel_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "set_field",
      "name": "total_frais_recreation",
      "value": "@calc(Math.round(@fields.nombre_enfants * @fields.frais_recreation * 160.0))"
    },
    {
      "type": "html",
      "value": "<p style=\"color: black;\">Les frais annuels de récréation sont calculés en multipliant les frais journaliers par 160 jours (5 jours par semaine pendant 8 mois)\n </p>"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "hint_price",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "html",
      "value": "<div style=\"background: #FFF3E0; padding: 20px; border-radius: 15px; text-align: center; border: 2px solid #E65100;\">\n  <span style=\"font-size: 16px; color: #6D4C41;\"> Frais récréation: </span>\n  \n  <div style=\"background: #E8F5E9; padding: 10px; border-radius: 10px;\">\n    <span style=\"color: #2E7D32; font-weight: bold; font-size: 20px;\">\n     @fields.total_frais_recreation drm\n    </span>\n  </div>\n</div>"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "**Frais totaux annuels des @fields.nombre_enfants enfants du @fields.niveau_text de l'UPA**"
    },
    {
      "type": "audio",
      "name": "audio_7_5",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/educ_total_niveau_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "set_field",
      "name": "totaux_frais_education",
      "value": "@calc(Number(@fields.total_frais_scolarite || 0) + Number(@fields.total_frais_fourniture || 0) + Number(@fields.total_frais_deplacement || 0) + Number(@fields.total_frais_recreation || 0))"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "hint_price",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "html",
      "value": "<div style=\"background-color: #C8E6C9; padding: 15px; border: 3px solid #2E7D32; border-radius: 12px; box-shadow: 0px 4px 10px rgba(46, 125, 50, 0.2); text-align: center; margin: 10px 0;\">\n  <span style=\"color: #1B5E20; font-weight: 800; font-size: 22px; display: block;\">\n    Frais totaux sont : @fields.totaux_frais_education drm\n  </span>\n</div>"
    },
    {
      "name": "last_niveau_scolaire",
      "value": "@calc((Number(@fields.niveau_scolaire_loop_idx) + 1) < Number(@fields.select_niveau_scolaire_count))"
    },
    {
      "name": "niveau_scolaire_loop_idx",
      "value": "@calc(Number(@fields.niveau_scolaire_loop_idx) + 1)"
    },
    {
      "name": "current_niveau_scolaire",
      "value": "@calc([@fields.premier_cycle ? 'premier_cycle' : null, @fields.second_cycle ? 'second_cycle' : null, @fields.lycee_professionnelle ? 'lycee_professionnelle' : null, @fields.universite ? 'universite' : null].filter(v => v !== null).at(Number(@local.niveau_scolaire_loop_idx)) || '')"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.totaux_frais_education"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_7_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_7_btn_continue",
      "value": "suivant",
      "action_list": "click | set_field: nombre_enfants_@fields.niveau_label:  @fields.nombre_enfants;\nclick | set_field: frais_scolarite_@fields.niveau_label:  @fields.frais_scolarite;\nclick | set_field: frais_fourniture_@fields.niveau_label:  @fields.frais_fourniture;\nclick | set_field: frais_deplacement_@fields.niveau_label:  @fields.frais_deplacement;\nclick | set_field: frais_recreation_@fields.niveau_label:  @fields.frais_recreation;\n\nclick | set_field: total_frais_scolarite_@fields.niveau_label: @fields.total_frais_scolarite;\nclick | set_field: total_frais_fourniture_@fields.niveau_label: @fields.total_frais_fourniture;\nclick | set_field: total_frais_deplacement_@fields.niveau_label: @fields.total_frais_deplacement;\nclick | set_field: total_frais_recreation_@fields.niveau_label: @fields.total_frais_recreation;\nclick | set_field: totaux_frais_education_@fields.niveau_label:@fields.totaux_frais_education;\n\nclick | set_field: nombre_enfants:;  \nclick | set_field: frais_scolarite:;\nclick | set_field: frais_fourniture:;\nclick | set_field: frais_deplacement:;\nclick | set_field: frais_recreation:;\n\nclick | set_field: current_niveau_scolaire : @local.current_niveau_scolaire;\n\n\nclick | set_field: niveau_scolaire_loop_idx : @local.niveau_scolaire_loop_idx;\nclick | set_data | _list_id: depenses_settings_pages, _index: 5, completed: false;\nclick | set_data | _list_id: depenses_settings_pages, _index: 6, completed: false;\n",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.last_niveau_scolaire",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page7_button_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: nombre_enfants_@fields.niveau_label:  @fields.nombre_enfants;\nclick | set_field: frais_scolarite_@fields.niveau_label:  @fields.frais_scolarite;\nclick | set_field: frais_fourniture_@fields.niveau_label:  @fields.frais_fourniture;\nclick | set_field: frais_deplacement_@fields.niveau_label:  @fields.frais_deplacement;\nclick | set_field: frais_recreation_@fields.niveau_label:  @fields.frais_recreation;\nclick | set_field: frais_recreation_@fields.niveau_label:  @fields.frais_recreation;\n\nclick | set_field: total_frais_scolarite_@fields.niveau_label:  @fields.total_frais_scolarite;\nclick | set_field: total_frais_fourniture_@fields.niveau_label:  @fields.total_frais_fourniture;\nclick | set_field: total_frais_deplacement_@fields.niveau_label:  @fields.total_frais_deplacement;\nclick | set_field: total_frais_recreation_@fields.niveau_label:  @fields.total_frais_recreation;\nclick | set_field: totaux_frais_education_@fields.niveau_label:  @fields.totaux_frais_education;\n\n\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "!@local.last_niveau_scolaire ",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}