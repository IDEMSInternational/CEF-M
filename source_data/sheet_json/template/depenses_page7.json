{
  "flow_type": "template",
  "flow_name": "depenses_page7",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "name": "page_title",
      "value": "@global.petite_depenses"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "text",
      "name": "autre_petit_depense",
      "value": "@global.autre_petit_depense"
    },
    {
      "type": "text",
      "name": "autre_depense_yesno",
      "value": "@global.autre_depense_yesno"
    },
    {
      "type": "text",
      "name": "autre_depense_yesno_hint",
      "value": "@global.autre_depense_yesno_hint",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "begin_radio_list",
      "name": "autre_depense"
    },
    {
      "type": "begin_data_items",
      "value": "@data.yes_no"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list"
    },
    {
      "name": "valid_autre_depense",
      "value": "@local.autre_depense != null && @local.autre_depense != undefined && @local.autre_depense != \"\""
    },
    {
      "type": "text",
      "name": "error_autre_depense",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_autre_depense",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "begin_display_group",
      "condition": "@local.autre_depense == \"yes\"",
      "style_list": "width: 100%; display: block;"
    },
    {
      "type": "html",
      "name": "nom_autre_frais_label",
      "value": "<span style=\"color: red;\">*</span> @global.nom_autre_frais_label",
      "style_list": "font-size:20px;"
    },
    {
      "type": "image",
      "value": "images/autre_depense.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text_box",
      "name": "nom_autre_frais",
      "value": "@fields.nom_autre_frais",
      "action_list": "changed | set_field : nom_autre_frais: this.value;"
    },
    {
      "name": "valid_nom_autre_frais",
      "value": "@calc(!!@fields.nom_autre_frais && @fields.nom_autre_frais != \"\")"
    },
    {
      "type": "text",
      "name": "error_nom_autre_frais",
      "value": "@global.error_required_answer",
      "condition": "@local.autre_depense == \"yes\" && @fields.attempt_submit && !@local.valid_nom_autre_frais",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px; margin-top:10px;"
    },
    {
      "type": "html",
      "name": "montant_autre_frais_label",
      "value": "<span style=\"color: red;\">*</span> @global.montant_autre_frais_label",
      "style_list": "font-size:20px; margin-top:20px;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "hint_price",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text_box",
      "name": "montant_autre_frais",
      "value": "@fields.montant_autre_frais",
      "action_list": "changed | set_field : montant_autre_frais: this.value;",
      "parameter_list": "number_input: true"
    },
    {
      "name": "valid_montant_autre_frais",
      "value": "@calc(!!@fields.montant_autre_frais && @fields.montant_autre_frais != \"\" && @fields.montant_autre_frais >= 0)"
    },
    {
      "type": "text",
      "name": "error_nom_autre_frais",
      "value": "@global.error_required_answer",
      "condition": "@local.autre_depense == \"yes\" && @fields.attempt_submit && !@local.valid_montant_autre_frais",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px; margin-top:10px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "completed_enabled",
      "value": "@calc(@local.autre_depense == \"no\" || (@local.autre_depense == \"yes\" && @local.valid_nom_autre_frais && @local.valid_montant_autre_frais))"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_7_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_7_btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_7_btn_continue",
      "value": "@global.btn_continue",
      "action_list": "click | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}