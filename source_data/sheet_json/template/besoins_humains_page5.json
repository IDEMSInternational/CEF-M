{
  "flow_type": "template",
  "flow_name": "besoins_humains_page5",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "SUPERFICIES DES CEREALES A CULTIVIER"
    },
    {
      "type": "text",
      "value": "**Les supperficies prévisionnelles sont calculées en fonction du rendement moyen des céréales (maïs, mil, sorgho et riz) de votre UPA**"
    },
    {
      "type": "image",
      "value": "images/superf_unit.jpg",
      "style_list": "width: 50%; object-fit: contain;"
    },
    {
      "name": "superficie_mais",
      "value": "@calc(Number(@fields.sac_mais || 0) > 0 ? (Number(@fields.sac_mais || 0) / Number(@fields.rend_moyen_mais || 1)).toFixed(1) : 0)"
    },
    {
      "name": "superficie_mil",
      "value": "@calc(Number(@fields.sac_mil || 0) > 0 ? (Number(@fields.sac_mil || 0) / Number(@fields.rend_moyen_mil || 1)).toFixed(1) : 0)"
    },
    {
      "name": "superficie_sorgho",
      "value": "@calc(Number(@fields.sac_sorgho || 0) > 0 ? (Number(@fields.sac_sorgho || 0) / Number(@fields.rend_moyen_sorgho || 1)).toFixed(1) : 0)"
    },
    {
      "name": "superficie_riz",
      "value": "@calc(Number(@fields.sac_riz || 0) > 0 ? (Number(@fields.sac_riz || 0) / Number(@fields.rend_moyen_riz || 1)).toFixed(1) : 0)"
    },
    {
      "name": "superficie_totale",
      "value": "@calc((Number(@local.superficie_mais) + Number(@local.superficie_mil) + Number(@local.superficie_sorgho) + Number(@local.superficie_riz)).toFixed(1))"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "Superficie à cultiver pour le Maïs"
    },
    {
      "type": "audio",
      "name": "audio_7_1",
      "parameter_list": "variant: button_only;\nsrc: audio/alimentationHumaine/sup_mais_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/sup_mais.jpg",
      "style_list": "width:150px; height:150px;"
    },
    {
      "type": "html",
      "value": "<p style=\"color: black;\"> Rendement moyen: @fields.rend_moyen_mais sac de 100kg/ha </p>",
      "style_list": "font-size: 12px; "
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "La superficie pour @fields.sac_mais sacs de maïs est:"
    },
    {
      "type": "html",
      "value": "<div style=\"color: #1e3656; font-weight: bold; font-size: 20px;\">@local.superficie_mais ha</div>"
    },
    {
      "type": "end_display_group"
