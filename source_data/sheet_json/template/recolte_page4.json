{
  "flow_type": "template",
  "flow_name": "recolte_page4",
  "status": "released",
  "rows": [
    {
      "name": "v_current_human",
      "value": "@calc(Number(@field.current_culture_index) + 1)"
    },
    {
      "type": "begin_display_group",
      "name": "header_top",
      "style_list": "background: #00adcc; padding: 15px; border-radius: 0 0 15px 15px; margin-bottom: 20px;"
    },
    {
      "type": "html",
      "value": "<div style=\"color: white; font-weight: bold; font-size: 14px;\">CULTURE @local.v_current_human / @field.total_cultures_selected </div>"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "style_list": "width: 100%; display: flex; flex-direction: column; align-items: center; border: 1px solid #FFCC80; border-radius: 12px; background: white; margin-bottom: 10px; overflow: hidden;"
    },
    {
      "type": "image",
      "value": "@calc(['mais','mil','sorgho','coton','arachide','fourrage','fonio','riz','sésame','wouandzou','patate','bissap'].includes((@field.active_culture_name || '').toLowerCase().trim()) ? 'images/' + @field.active_culture_name + '.jpg' : 'images/autre.jpeg')",
      "style_list": "width: 60%; object-fit: contain;"
    },
    {
      "type": "text",
      "value": "<h3 style='color: black; margin: 10px 0;'>Culture : <span style='color: #e3a730;'>@field.active_culture_name</span></h3>",
      "style_list": "font-weight: bold; font-size: 18px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "html",
      "value": "<br><b style=\"color: #e67e22\">AUTRE COÛT A LA RECOLTE</b>"
    },
    {
      "type": "begin_display_group",
      "name": "grp_autre_cout_recolte",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "name": "note_autre_cout_recolte",
      "parameter_list": "variant: button_only;\nsrc: audio/postSemi/on_autre_cout_recolte_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red;\">*</span>Ecrivez le nom(s) d'autre(s) coût(s)"
    },
    {
      "type": "text",
      "value": "*Ces coûts couvrent des services ou intrants non pris en compte.*"
    },
    {
      "type": "radio_button_grid",
      "name": "no_autre_cout_recolte",
      "value": "@field.no_autre_cout_recolte",
      "action_list": "changed | set_field: no_autre_cout_recolte : this.value;",
      "parameter_list": "answer_list: @data.yes_no;\nvariant: flex;\nstyle: secondary;\nitem_width: 60px;\ngrid_gap: 8px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "group_nom_autre",
      "condition": "@field.no_autre_cout_recolte == 'oui'",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "name": "note_autre_cout_recolte2",
      "parameter_list": "variant: button_only;\nsrc: audio/postSemi/nom_autre_cout_recolte_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red;\">*</span> Indiquez s'il y a d'autre(s) coût(s) à la récolte non renseignés"
    },
    {
      "type": "image",
      "value": "images/ecrire.jpg",
      "style_list": "width: 60%; object-fit: contain;\n"
    },
    {
      "type": "text_box",
      "name": "nom_autre_cout_recolte",
      "value": "@field.nom_autre_cout_recolte",
      "action_list": "changed | set_field: nom_autre_cout_recolte : this.value;",
      "parameter_list": "placeholder: Nom des coûts...;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "*La réponse est obligatoire !*",
      "condition": "@calc(@field.no_autre_cout_recolte == 'oui' && (@field.nom_autre_cout_recolte == '' || @field.nom_autre_cout_recolte == null))",
      "style_list": "color: red; font-size: 12px;"
    },
    {
      "name": "v_montant_autre_err",
      "value": "@calc(!/^\\d+(\\.\\d+)?$/.test(@field.autre_cout_recolte) || Number(@field.autre_cout_recolte) < 0)"
    },
    {
      "type": "begin_display_group",
      "name": "group_montant_autre",
      "condition": "@field.no_autre_cout_recolte == 'oui'",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "name": "note_autre_cout_recolte1",
      "parameter_list": "variant: button_only;\nsrc: audio/postSemi/autre_cout_recolte_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red;\">*</span>Donnez le montant du coût pour <span style=\"color: #e67e22\"> @field.nom_autre_cout_recolte</span>"
    },
    {
      "type": "text",
      "value": "S'il y a plusieurs éléments, donnez le coût agrégé de l'ensemble",
      "style_list": "font-style: italic; color: #666; font-size: 12px;"
    },
    {
      "type": "text",
      "value": "*Rappel : 1 dram = 5 FCFA*",
      "style_list": "font-size: 14px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width: 80px; object-fit: contain;"
    },
    {
      "type": "text_box",
      "name": "autre_cout_recolte",
      "value": "@field.autre_cout_recolte",
      "action_list": "changed | set_field: autre_cout_recolte: this.value;",
      "parameter_list": "number_input: true; placeholder: Montant en Dram...;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "*Mettez une valeur positive*",
      "condition": "@calc(@field.no_autre_cout_recolte == 'oui' && @local.v_montant_autre_err)",
      "style_list": "color: red; font-size: 12px;"
    },
    {
      "name": "v_autre_cout_ok",
      "value": "@calc(@field.no_autre_cout_recolte == 'non' || (@field.no_autre_cout_recolte == 'oui' && @field.nom_autre_cout_recolte != '' && @field.nom_autre_cout_recolte != null && !@local.v_montant_autre_err))"
    },
    {
      "name": "v_valeur_autre_cout",
      "value": "@calc(@field.no_autre_cout_recolte == 'oui' ? Number(@field.autre_cout_recolte) : 0)"
    },
    {
      "name": "completed_enabled",
      "value": "@local.v_autre_cout_ok"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_completed",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: final_cout_autre_recolte : @local.v_valeur_autre_cout;\nclick | emit: completed",
      "parameter_list": "style: navigation;\ndisabled: !@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}