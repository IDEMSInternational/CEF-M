{
  "flow_type": "template",
  "flow_name": "superficie_champs_page11",
  "status": "released",
  "rows": [
    {
      "type": "subtitle",
      "value": "**Association de cultures**"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "Indiquez si d’autre(s) culture(s) sont associées avec @fields.cult_princip dans la parcellle N⁰@fields.num_parcelle"
    },
    {
      "type": "audio",
      "name": "audio_11_1",
      "parameter_list": "variant: compact;\nsrc: audio/Superficie/asso_yesno_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/association.jpg",
      "style_list": "width:100px; height:100px; "
    },
    {
      "type": "html",
      "value": "<p style=\"color: black;\">Il s'agit de l'association de deux ou plusieurs cultures dans la même parcelle avec la culture principale</p>"
    },
    {
      "type": "begin_radio_list",
      "value": "@fields.association_oui_non",
      "action_list": "changed | set_field: association_oui_non : this.value;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.oui_non"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list"
    },
    {
      "type": "html",
      "name": "html_text",
      "value": "<p style=\"color: red;\"> @global.warning_message </p>",
      "condition": "!@fields.association_oui_non"
    },
    {
      "type": "subtitle",
      "value": "**Association de cultures dans la parcelle N⁰@fields.num_parcelle de @fields.nom_champ**",
      "condition": "@fields.association_oui_non == 'oui'"
    },
    {
      "type": "begin_data_items",
      "value": "@data.cult_princip",
      "parameter_list": "filter: @item.name == @fields.cult_princip",
      "condition": "@fields.association_oui_non == 'oui'"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.association_oui_non == 'oui'"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width:150px; height:150px; "
    },
    {
      "type": "text",
      "value": "@item.name"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.association_oui_non == 'oui'"
    },
    {
      "type": "text",
      "value": "Sélectionnez les cultures associées à @fields.cult_princip dans la parcelle N⁰@fields.num_parcelle "
    },
    {
      "type": "audio",
      "name": "audio_11_1",
      "parameter_list": "variant: compact;\nsrc: audio/Superficie/cult_asso_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "valid_cult_asso",
      "value": "@calc(!!@fields.coton || !!@fields.mais || !!@fields.mil || !!@fields.sorgho || !!@fields.arachide || !!@fields.fourrage || !!@fields.fonio | !!@fields.riz | !!@fields.sesame | !!@fields.wauandzou | !!@fields.patate_douce | !!@fields.bissap)"
    },
    {
      "type": "begin_data_items",
      "value": "@data.culture_association",
      "condition": "@fields.association_oui_non == 'oui'"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.association_oui_non == 'oui'"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width:90px; height:90px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "simple_checkbox",
      "name": "@item.name",
      "value": "@fields.@item.name",
      "action_list": "changed | set_field: @item.name: !@fields.@item.name;",
      "parameter_list": "label_text: @item.text;",
      "exclude_from_translation": true,
      "style_list": "margin-bottom: 10px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.autre_culture1 == true && @fields.association_oui_non == 'oui'"
    },
    {
      "type": "text",
      "value": "@global.autre_message"
    },
    {
      "type": "audio",
      "name": "audio_11_2",
      "parameter_list": "variant: compact;\nsrc: audio/Superficie/autre_cult_nom1_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "action_list": "changed | set_field: autre_cult_asso1: this.value;",
      "parameter_list": "max_length: 30;\nplaceholder: Encrivez le nom ",
      "condition": "@fields.autre_culture1 == true && @fields.association_oui_non == 'oui'",
      "exclude_from_translation_1": true
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.autre_culture2 == true && @fields.association_oui_non == 'oui'"
    },
    {
      "type": "text",
      "value": "@global.autre_message"
    },
    {
      "type": "audio",
      "name": "audio_11_3",
      "parameter_list": "variant: compact;\nsrc: audio/Superficie/autre_cult_nom2_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "action_list": "changed | set_field: autre_cult_asso2: this.value;",
      "parameter_list": "max_length: 30;\nplaceholder: Encrivez le nom ",
      "condition": "@fields.autre_culture2 == true && @fields.association_oui_non == 'oui'",
      "exclude_from_translation_1": true
    },
    {
      "name": "cult_asso_selected",
      "value": "@calc([@fields.coton ? 'coton' : null,@fields.mais ? 'mais' : null,@fields.mil ? 'mil' : null,@fields.sorgho ? 'sorgho' : null,@fields.arachide ? 'arachide' : null,@fields.fourrage ? 'fourrage' : null,@fields.fonio ? 'fonio' : null,@fields.riz ? 'riz' : null,@fields.sesame ? 'sesame' : null,@fields.wauandzou ? 'wauandzou' : null,@fields.patate_douce ? 'patate_douce' : null,@fields.bissap ? 'bissap' : null,@fields.autre_cult_asso1 ? @fields.autre_cult_asso1 : null,@fields.autre_cult_asso2 ? @fields.autre_cult_asso2: null].filter(v => v !== null).join(','))"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "exclude_from_translation": "padding: 12px 24px;"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.association_oui_non",
      "exclude_from_translation": true
    },
    {
      "type": "round_button",
      "name": "page11_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page11_button_continue",
      "value": "Continuer",
      "action_list": "click | set_field: @calc('cult_asso_selected_parcelle_N' + @fields.num_parcelle) : @local.cult_asso_selected;\nclick | set_field: @calc('association_oui_non_parcelle_N⁰' + @fields.num_parcelle) : @fields.association_oui_non;\nclick | set_field: @calc('autre_cult_asso1_parcelle_N⁰' + @fields.num_parcelle) : @fields.autre_cult_asso1;\nclick | set_field: @calc('autre_cult_asso2_parcelle_N⁰' + @fields.num_parcelle) : @fields.autre_cult_asso2;\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled"
    },
    {
      "type": "end_display_group"
    }
  ]
}