{
  "flow_type": "template",
  "flow_name": "enrolment_page7",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "SOCIETE COOPERATIVE|COTON"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@global.fr_scpc_id_note"
    },
    {
      "type": "audio",
      "name": "audio_8_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Enrolement/federation_scpc_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/op_coton.jpg",
      "style_list": "width:100px; height:100px; "
    },
    {
      "type": "begin_radio_list",
      "value": "@fields.fr_scpc_id",
      "action_list": "changed | set_field : fr_scpc_id: this.value;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.village_FR_SCPC",
      "parameter_list": "filter: @item.village == @fields.village_id"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list"
    },
    {
      "type": "html",
      "value": "<p style=\"color: red;\"> @global.reponse_obligatoire </p>",
      "condition": "!@fields.fr_scpc_id && @fields.attempt_submit"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@global.us_scpc_id_note"
    },
    {
      "type": "audio",
      "name": "audio_8_2",
      "parameter_list": "variant: button_only;\nsrc: audio/Enrolement/union_sect_scpc_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/op_coton.jpg",
      "style_list": "width:100px; height:100px; "
    },
    {
      "type": "begin_radio_list",
      "value": "@fields.us_scpc_id",
      "action_list": "changed | set_field : us_scpc_id: this.value;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.village_UN_SCPC",
      "parameter_list": "filter: @item.village == @fields.village_id"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list"
    },
    {
      "type": "html",
      "value": "<p style=\"color: red;\"> @global.reponse_obligatoire </p>",
      "condition": "!@fields.us_scpc_id && @fields.attempt_submit"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@global.base_scpc_id_note"
    },
    {
      "type": "audio",
      "name": "audio_8_3",
      "parameter_list": "variant: button_only;\nsrc: audio/Enrolement/scpc_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/op_coton.jpg",
      "style_list": "width:100px; height:100px; "
    },
    {
      "type": "begin_radio_list",
      "value": "@fields.base_scpc_id",
      "action_list": "changed | set_field : base_scpc_id: this.value;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.village_SCPC",
      "parameter_list": "filter: @item.village == @fields.village_id"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list"
    },
    {
      "type": "html",
      "value": "<p style=\"color: red;\"> @global.reponse_obligatoire </p>",
      "condition": "!@fields.base_scpc_id && @fields.attempt_submit"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.fr_scpc_id && @fields.us_scpc_id && @fields.base_scpc_id"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_8_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_8_button_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: false;\nclick | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
