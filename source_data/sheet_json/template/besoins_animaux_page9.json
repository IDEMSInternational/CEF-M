{
  "flow_type": "template",
  "flow_name": "besoins_animaux_page9",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "**SOURCES ET DÉPENSE DE SON**"
    },
    {
      "type": "text",
      "value": "@global.qtite_son_prod"
    },
    {
      "type": "html",
      "value": "<p style=\"color: black;\"> @global.hint_qtite_son_prod</p>"
    },
    {
      "type": "text_box",
      "name": "concentre_produit",
      "value": "@fields.concentre_produit",
      "action_list": "changed | set_field: concentre_produit : this.value;",
      "parameter_list": "number_input: true;\nplaceholder: Donnez la quantité de son de céréales;",
      "exclude_from_translation": true
    },
    {
      "type": "html",
      "name": "html_text",
      "value": "<p style=\"color: red;\"> @global.warning_message </p>",
      "condition": "!@local.concentre_produit "
    },
    {
      "name": "valid_concentre_produit",
      "value": "@calc((/^\\d+$/.test(@fields.concentre_produit) && @fields.concentre_produit <= @fields.quantite_son ) || @fields.concentre_produit == '' || !@fields.concentre_produit)"
    },
    {
      "type": "text",
      "value": "@global.validite_nombre",
      "condition": "!@local.valid_concentre_produit",
      "exclude_from_translation": true,
      "style_list": "color: #FF0000;\nfont-size: 14px"
    },
    {
      "type": "text",
      "value": "@global.qtite_son_achete"
    },
    {
      "type": "image",
      "value": "images/son_cereal.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "set_field",
      "name": "achat_son_quantite",
      "value": "@calc(Number(@fields.quantite_son) - Number(@fields.concentre_produit))",
      "condition": "@fields.concentre_produit"
    },
    {
      "type": "html",
      "name": "note_achat_son",
      "value": "<div style=\"background-color: #f0f4f8; border-left: 4px solid #0056b3; padding: 12px 16px; border-radius: 4px; margin: 8px 0; font-family: sans-serif;\">\n Quantité de son à achéter: <strong> @fields.achat_son_quantite sacs\n</strong> </div>",
      "condition": "@fields.concentre_produit"
    },
    {
      "type": "html",
      "value": "<p style=\"color: black;\"> @global.hint_qtite_son_achete </p>",
      "condition": "@fields.concentre_produit"
    },
    {
      "type": "text",
      "value": "@global.prix_sac_son"
    },
    {
      "type": "html",
      "value": "<p style=\"color: black;\">*1 drm=5 FCFA*</p>"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text_box",
      "name": "prix_sac_son",
      "value": "@fields.prix_sac_son",
      "action_list": "changed | set_field: prix_sac_son : this.value;",
      "parameter_list": "number_input: true;\nplaceholder: Donnez le prix d'un sac de son de céréales;",
      "exclude_from_translation": true
    },
    {
      "type": "html",
      "name": "html_text",
      "value": "<p style=\"color: red;\"> @global.warning_message </p>",
      "condition": "!@fields.prix_sac_son "
    },
    {
      "name": "valid_prix_sac_son",
      "value": "@calc((/^\\d+$/.test(@fields.prix_sac_son) && @fields.prix_sac_son > 0 ) || @fields.prix_sac_son == '' || !@fields.prix_sac_son)"
    },
    {
      "type": "text",
      "value": "@global.validite_nombre",
      "condition": "!@local.valid_prix_sac_son",
      "exclude_from_translation": true,
      "style_list": "color: #FF0000;\nfont-size: 14px"
    },
    {
      "type": "text",
      "value": "@global.note_montant_son",
      "condition": "@fields.prix_sac_son "
    },
    {
      "type": "html",
      "value": "<p style=\"color: black;\">*1 drm=5 FCFA*</p>",
      "condition": "@fields.prix_sac_son "
    },
    {
      "type": "image",
      "value": "images/cfa_tot.jpg",
      "condition": "@fields.prix_sac_son ",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "set_field",
      "name": "cal_depense_son",
      "value": "@calc(Number(@fields.achat_son_quantite) * Number(@fields.prix_sac_son))",
      "condition": "@fields.prix_sac_son "
    },
    {
      "type": "text",
      "value": "@global.montant_son",
      "condition": "@fields.prix_sac_son ",
      "style_list": "background-color: #f0f4f8 ;border-left-width: 4px; border-left-style: solid; border-left-color: #0056b3;"
    },
    {
      "type": "html",
      "value": "<p style=\"color: black;\">@global.hint_montant_son</p>",
      "condition": "@fields.prix_sac_son "
    },
    {
      "name": "completed_enabled",
      "value": "@fields.concentre_produit && @fields.prix_sac_son"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page11_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page11_button_continue",
      "value": "Continuer",
      "action_list": "click | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}