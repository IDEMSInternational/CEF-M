{
  "flow_type": "template",
  "flow_name": "section_fumure_page9",
  "status": "released",
  "rows": [
    {
      "name": "superficie_rotation",
      "value": "@calc(Math.round((@fields.superficie_exploitation / 3) * 100) / 100)"
    },
    {
      "name": "superficie_cycle",
      "value": "@calc(Math.round((@fields.portion_fertilisable * 3) * 100) / 100)"
    },
    {
      "name": "gap_annuel",
      "value": "@calc(Math.round((@local.superficie_rotation - @fields.portion_fertilisable) * 100) / 100)"
    },
    {
      "name": "gap_cycle",
      "value": "@calc(Math.round((@local.gap_annuel * 3) * 100) / 100)"
    },
    {
      "name": "gap_cycle_pour100",
      "value": "@calc(Math.round((@local.gap_cycle / @fields.superficie_exploitation) * 100))"
    },
    {
      "name": "nb_annee",
      "value": "@calc(@fields.superficie_exploitation % @fields.portion_fertilisable == 0 ? (@fields.superficie_exploitation / @fields.portion_fertilisable) : Math.floor(@fields.superficie_exploitation / @fields.portion_fertilisable) + 1)"
    },
    {
      "type": "title",
      "name": "cycle_3_ans",
      "value": "@global.cycle_3_ans",
      "condition": "@local.nb_annee <= 3"
    },
    {
      "name": "cycle_4_ans",
      "value": "@global.cycle_4_ans",
      "condition": "@local.nb_annee == 4"
    },
    {
      "name": "cycle_5_ans",
      "value": "@global.cycle_5_ans",
      "condition": "@local.nb_annee > 4"
    },
    {
      "type": "begin_display_group",
      "condition": "@local.nb_annee <= 3",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "text",
      "name": "note_infos_3",
      "value": "@global.note_infos_3"
    },
    {
      "type": "image",
      "name": "note_infos_3_img",
      "value": "images/cycle3.jpg"
    },
    {
      "type": "text",
      "name": "note_courage",
      "value": "@global.note_courage",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "condition": "@local.nb_annee == 4",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "text",
      "name": "note_infos_4",
      "value": "@global.note_infos_4"
    },
    {
      "type": "image",
      "name": "note_infos_4_img",
      "value": "images/cycle4.jpg"
    },
    {
      "type": "text",
      "name": "info_gap_4",
      "value": "@global.info_gap_4"
    },
    {
      "type": "text",
      "name": "strategie_production_4",
      "value": "@global.strategie_production_4"
    },
    {
      "type": "text",
      "name": "note_strategie_4",
      "value": "@global.note_strategie_4"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "condition": "@local.nb_annee > 4",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "text",
      "name": "note_infos_5",
      "value": "@global.note_infos_5"
    },
    {
      "type": "image",
      "name": "note_infos_5_img",
      "value": "images/cycle5.jpg"
    },
    {
      "type": "text",
      "name": "info_gap_5",
      "value": "@global.info_gap_5"
    },
    {
      "type": "text",
      "name": "strategie_production_5",
      "value": "@global.strategie_production_5"
    },
    {
      "type": "text",
      "name": "note_strategie_5",
      "value": "@global.note_strategie_5"
    },
    {
      "type": "image",
      "name": "note_strategie_5_img",
      "value": "images/type_fumure.jpg"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_9_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_9_btn_continue",
      "value": "@global.btn_continue",
      "action_list": "click | emit: completed",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}