{
  "flow_type": "template",
  "flow_name": "besoins_humains_page8",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "SUPERFICIES DES CEREALES A CULTIVIER"
    },
    {
      "type": "image",
      "value": "images/superf_unit.jpg",
      "style_list": "width: 50%; object-fit: contain;"
    },
    {
      "type": "html",
      "value": "<div style=\"background: #f0f7ff; border-left: 4px solid #1e3656; padding: 15px; border-radius: 4px 8px 8px 4px; margin: 10px 0;\">\n    <p style=\"margin: 0; color: #1e3656; font-size: 13.5px; line-height: 1.5;\">\n        <span style=\"font-weight: bold; text-transform: uppercase; font-size: 11px; display: block; margin-bottom: 5px; color: #4f8ff1;\">Méthode de calcul</span>\n        Les superficies prévisionnelles sont calculées en fonction du <b>rendement moyen</b> des céréales (maïs, mil et sorgho) par type d'exploitation.\n    </p>\n</div>"
    },
    {
      "name": "superf_mais",
      "value": "@calc(Math.round(((@field.sac_mais * 100) / @field.rend_mais) * 10) / 10)"
    },
    {
      "name": "superf_mil",
      "value": "@calc(Math.round(((@field.sac_mil * 100) / @field.rend_mil) * 10) / 10)"
    },
    {
      "name": "superf_sorgho",
      "value": "@calc(Math.round(((@field.sac_sorgho * 100) / @field.rend_sorgho) * 10) / 10)"
    },
    {
      "name": "superf_totale",
      "value": "@calc(Math.round((@local.superf_mais + @local.superf_mil + @local.superf_sorgho) * 100) / 100)"
    },
    {
      "type": "begin_display_group",
      "name": "result_total",
      "style_list": "background: #1e3656; padding: 25px;text-align: center;"
    },
    {
      "type": "html",
      "value": "<div style=\"color: #4f8ff1; font-size: 13px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;\">Surface Totale à Cultiver</div>"
    },
    {
      "type": "html",
      "value": "<div style=\"color: white; font-size: 36px; font-weight: bold; margin: 10px 0;\">@local.superf_totale ha</div>"
    },
    {
      "type": "html",
      "value": "<div style=\"color: #a5c7f9; font-size: 12px; font-style: italic;\">Calculé selon les rendements de votre zone</div>"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "item_mais",
      "style_list": "background: #fff;padding: 15px; margin-bottom: 12px;"
    },
    {
      "type": "image",
      "value": "images/sup_mais.jpg",
      "style_list": "width: 70px; border-radius: 8px; margin-right: 15px;"
    },
    {
      "type": "html",
      "value": "<div style=\"flex: 1;\"><b style=\"color: #333;\">Maïs (@field.sac_mais sacs)</b><br><span style=\"color: #666; font-size: 12px;\">Rendement : @field.rend_mais kg/ha</span></div>"
    },
    {
      "type": "html",
      "value": "<div style=\"color: #1e3656; font-weight: bold; font-size: 18px;\">@local.superf_mais ha</div>"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "item_mil",
      "style_list": "background: #fff;padding: 15px; margin-bottom: 12px;"
    },
    {
      "type": "image",
      "value": "images/sup_mil.jpg",
      "style_list": "width: 70px; border-radius: 8px; margin-right: 15px;"
    },
    {
      "type": "html",
      "value": "<div style=\"flex: 1;\"><b style=\"color: #333;\">Mil (@field.sac_mais sacs)</b><br><span style=\"color: #666; font-size: 12px;\">Rendement : @field.rend_mil kg/ha</span></div>"
    },
    {
      "type": "html",
      "value": "<div style=\"color: #1e3656; font-weight: bold; font-size: 18px;\">@local.superf_mais ha</div>"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "item_sorgho",
      "style_list": "background: #fff;padding: 15px; margin-bottom: 12px;"
    },
    {
      "type": "image",
      "value": "images/sup_sorgho.jpg",
      "style_list": "width: 70px; border-radius: 8px; margin-right: 15px;"
    },
    {
      "type": "html",
      "value": "<div style=\"flex: 1;\"><b style=\"color: #333;\">Sorgho (@field.sac_sorgho sacs)</b><br><span style=\"color: #666; font-size: 12px;\">Rendement : @field.rend_sorgho kg/ha</span></div>"
    },
    {
      "type": "html",
      "value": "<div style=\"color: #1e3656; font-weight: bold; font-size: 18px;\">@local.superf_mais ha</div>"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_completed",
      "value": "@global.btn_continue",
      "action_list": "click | emit: completed",
      "parameter_list": "style: navigation;\n",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}