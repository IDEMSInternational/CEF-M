{
  "flow_type": "template",
  "flow_name": "cultures_page5",
  "status": "released",
  "rows": [
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_data_items",
      "value": "@data.planif_cultures_primaires",
      "parameter_list": "filter: @item.name == @fields.culture_label"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width:150px; height:150px; "
    },
    {
      "type": "text",
      "value": "**@item.text**"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "title",
      "value": "PREVISIONS VARIETES DE SEMENCES"
    },
    {
      "type": "text",
      "value": "**Selectionnez la/les variété(s) de semences à utiliser pour @fields.superficie_ha_prevue ha**"
    },
    {
      "type": "text",
      "value": "La superficie totale peut être cultivée avec une ou plusieurs variétés de semences",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.planif_semences",
      "parameter_list": "filter: @item.cult_name == @fields.culture_label;"
    },
    {
      "type": "simple_checkbox",
      "name": "@item.name",
      "value": "@fields.@item.name",
      "action_list": "changed | set_field: @item.name: !@fields.@item.name;\n",
      "parameter_list": "label_text: @item.text; reverse: false; align: left; ",
      "style_list": "margin-bottom: 10px;"
    },
    {
      "type": "set_field",
      "name": "variete_label",
      "value": "@item.text",
      "condition": "@fields.@item.name"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "condition": "@fields.autre_variete"
    },
    {
      "type": "text",
      "value": "**Ecrivez le nom de l'autre variété**"
    },
    {
      "type": "text",
      "value": "*Il s'agit d'une variété qui n'existe pas dans la liste des variétés ci-dessus*",
      "style_list": "font-size: 12px; color: #718096; font-style: italic;"
    },
    {
      "type": "image",
      "value": "images/ecrire.jpg",
      "style_list": "width: 40%; object-fit: contain; "
    },
    {
      "type": "text_box",
      "name": "autre_variete_nom",
      "value": "@fields.autre_variete_nom",
      "action_list": "changed | set_field: autre_variete : this.value;",
      "parameter_list": "placeholder: Ecrivez le nom de l'autre variété;"
    },
    {
      "type": "text",
      "value": "*La réponse est obligatoire, aucune valeur n'a été donnée!*",
      "condition": "@calc(@fields.autre_variete && (@fields.autre_variete == '' || @fields.autre_variete == null))",
      "style_list": "color: #d71920; font-size: 12px; font-weight: bold; margin-top: 4px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.variete_label"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_5_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_4_btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_5_btn_continue",
      "value": "Continuer",
      "action_list": "click | set_field: attempt_submit: false;\nclick | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}